   401	    # Patched targets: the wrapped original (our wrapper is identity-checked);
   402	    # dependencies: the live object. Attached members are plugin code.
   403	    relied_on = {**{d: _raw_attribute(d) for d in depends}, **originals}
   404	    _snapshots.update({n: (obj, _describe(obj)) for n, obj in relied_on.items()})

   325	
   326	def _verify_attached(attaches: list[AttachSpec]) -> None:
   327	    missing = [
   328	        spec.target for spec in attaches if _raw_attribute(spec.target) is not spec.value
   329	    ]
   330	    if missing:
   331	        raise PluginActivationError(f"Members were not attached: {missing}")

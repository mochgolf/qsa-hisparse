   211	
   212	
   213	def definition_record(path: str | Path, qualname: str) -> dict:
   214	    data = Path(path).read_bytes()
   215	    node, enclosing = _locate(ast.parse(data), qualname)
   216	    lines = data.splitlines(keepends=True)
   217	    first = _first_line(node)
   218	    segment = b"".join(_header(lines, k) for k in enclosing)
   219	    segment += b"".join(lines[first - 1 : node.end_lineno])
   220	    return {
   221	        "qualname": qualname,
   222	        "kind": "class" if isinstance(node, ast.ClassDef) else "function",
   223	        "first_line": first,
   224	        "def_line": node.lineno,
   225	        "sha256": _sha256(segment),
   226	        "module_sha256": _sha256(data),
   227	    }
   228	
   229	
   230	# Live bindings ------------------------------------------------------------------
   231	#
   232	# A binding chain describes the attribute and every level beneath it
   233	# (descriptor ``__func__``, ``property.fget``, ``__wrapped__``). Each level must
   234	# be a kind whose behavior is identified by the description; anything else is
   235	# rejected when the record is written (patches may opt out per name with
   236	# ``unchecked_bindings``, keeping module bytes pinned). Functions whose code is
   237	# outside the pinned tree (library decorators) also describe their closure and
   238	# defaults, which is where decorator factories keep their configuration.
   239	
   240	CHAIN_FORMAT = 2  # Bump whenever live_chain's description changes.
   241	_SCALARS = (type(None), bool, int, float, complex, str, bytes)
   242	_MAX_ITEMS = 64
   243	
   244	
   245	class Undescribable(LookupError):
   246	    """A binding level whose behavior the chain cannot identify."""
   247	
   248	
   249	def _type_name(value: object) -> str:
   250	    kind = value if isinstance(value, type) else type(value)
   251	    return f"{kind.__module__}.{kind.__qualname__}"
   252	
   253	
   254	def _location(filename: str, root: Path) -> tuple[str, bool]:
   255	    path = Path(filename).resolve()
   256	    try:
   257	        return path.relative_to(root.resolve()).as_posix(), True
   258	    except ValueError:
   259	        return "<external>/" + path.name, False
   260	
   261	
   262	def _code(function, root: Path) -> dict:
   263	    code = function.__code__
   264	    location, internal = _location(code.co_filename, root)
   265	    entry = {
   266	        "code": [location, code.co_firstlineno],
   267	        "function": f"{function.__module__}.{function.__qualname__}",
   268	    }
   269	    if internal:
   270	        entry["file_sha256"] = _sha256(Path(code.co_filename).read_bytes())
   271	    return entry, internal
   272	
   273	
   274	def _function_state(function, root: Path, depth: int) -> dict:
   275	    """Code identity plus everything a function object carries besides code."""
   276	    entry, _ = _code(function, root)
   277	    entry["closure"] = [
   278	        [name, describe_value(cell.cell_contents, root, depth)]
   279	        for name, cell in zip(function.__code__.co_freevars, function.__closure__ or ())
   280	    ]
   281	    entry["defaults"] = describe_value(function.__defaults__, root, depth)
   282	    entry["kwdefaults"] = describe_value(function.__kwdefaults__ or {}, root, depth)
   283	    return entry
   284	
   285	
   286	def describe_value(value: object, root: Path, depth: int = 0) -> object:
   287	    """Identity of a closure cell, default or partial argument."""
   288	    if depth > 4:
   289	        raise Undescribable("nested too deeply")
   290	    if isinstance(value, _SCALARS):
   291	        return repr(value)
   292	    try:
   293	        import torch
   294	
   295	        if isinstance(value, (torch.dtype, torch.device)):
   296	            return repr(value)
   297	    except ImportError:
   298	        pass
   299	    if isinstance(value, type):
   300	        return {"type": _type_name(value)}
   301	    if inspect.ismodule(value):
   302	        return {"module": value.__name__}
   303	    if isinstance(value, enum.Enum):
   304	        return {"enum": f"{_type_name(value)}.{value.name}"}
   305	    if inspect.isfunction(value):
   306	        return _function_state(value, root, depth + 1)
   307	    if inspect.ismethod(value):
   308	        return {
   309	            "method": f"{_type_name(value.__self__)}.{value.__func__.__qualname__}",
   310	            "self": describe_value(getattr(value.__self__, "__dict__", {}), root, depth + 1),
   311	        }
   312	    if inspect.isbuiltin(value):
   313	        return {"builtin": f"{getattr(value, '__module__', None)}.{value.__qualname__}"}
   314	    if isinstance(value, (tuple, list, frozenset, set)) and len(value) <= _MAX_ITEMS:
   315	        items = [describe_value(v, root, depth + 1) for v in value]
   316	        return {_type_name(value): sorted(map(repr, items)) if isinstance(value, (set, frozenset)) else items}
   317	    if isinstance(value, dict) and len(value) <= _MAX_ITEMS and all(isinstance(k, str) for k in value):
   318	        return {"dict": {k: describe_value(v, root, depth + 1) for k, v in sorted(value.items())}}
   319	    if isinstance(value, functools.partial):
   320	        return {
   321	            "partial": describe_value(value.func, root, depth + 1),
   322	            "args": describe_value(value.args, root, depth + 1),
   323	            "keywords": describe_value(value.keywords, root, depth + 1),
   324	        }
   325	    raise Undescribable(f"cannot identify value of type {_type_name(value)}")
   326	
   327	
   328	def _level(current: object, root: Path) -> tuple[dict, object]:
   329	    """Describe one level and return the next level beneath it (or None)."""
   330	    entry: dict = {"type": _type_name(current)}
   331	    if isinstance(current, (staticmethod, classmethod)):
   332	        return entry, current.__func__
   333	    if isinstance(current, property):
   334	        return entry, current.fget
   335	    if isinstance(current, type):
   336	        location = None
   337	        try:
   338	            location, internal = _location(inspect.getsourcefile(current), root)
   339	            if internal:
   340	                entry["file_sha256"] = _sha256((root / location).read_bytes())
   341	        except TypeError:
   342	            pass
   343	        entry.update(type_name=_type_name(current), file=location)
   344	        entry["members"] = {
   345	            name: live_chain(member, root)
   346	            for name, member in sorted(current.__dict__.items())
   347	            if inspect.isfunction(member)
   348	            or isinstance(member, (staticmethod, classmethod, property, functools.partial))
   349	        }
   350	        return entry, None
   351	    if inspect.isfunction(current):
   352	        entry.update(_function_state(current, root, 0))
   353	        return entry, getattr(current, "__wrapped__", None)
   354	    if isinstance(current, functools.partial):
   355	        entry["partial"] = describe_value(current, root)
   356	        return entry, None
   357	    if type(current).__name__ == "_lru_cache_wrapper":
   358	        entry["cache_parameters"] = current.cache_parameters()
   359	        return entry, current.__wrapped__
   360	    if type(current).__qualname__ in ("OpOverloadPacket", "OpOverload"):
   361	        name = getattr(current, "_qualified_op_name", None) or getattr(current, "name", None)
   362	        if callable(name):
   363	            name = name()
   364	        if not name:
   365	            raise Undescribable("operator without a qualified name")
   366	        entry["op"] = str(name)
   367	        entry["dispatch"] = _dispatch_registrations(str(name), root)
   368	        return entry, None
   369	    raise Undescribable(f"cannot identify binding level of type {_type_name(current)}")
   370	
   371	
   372	def _dispatch_registrations(op: str, root: Path) -> list[str]:
   373	    """Dispatcher kernel registrations of ``op`` with normalized locations."""
   374	    import torch
   375	
   376	    def normalize(match):
   377	        location, _ = _location(match.group(1), root)
   378	        return f"registered at {location}:{match.group(2)}"
   379	
   380	    try:
   381	        dump = torch._C._dispatch_dump(op)
   382	    except RuntimeError as error:
   383	        raise Undescribable(f"no dispatcher entry for {op}: {error}") from error
   384	    lines = []
   385	    for line in dump.splitlines():
   386	        if line.startswith(("name:", "schema:", "debug:", "alias analysis")):
   387	            lines.append(line)
   388	        elif "registered at" in line:
   389	            lines.append(re.sub(r"registered at (\S+?):(\d+)", normalize, line))
   390	    return lines
   391	
   392	
   393	def raw_attribute(target: str) -> object:
   394	    owner_path, name = target.rsplit(".", 1)
   395	    owner = pkgutil.resolve_name(owner_path)
   396	    if isinstance(owner, type) and name in owner.__dict__:
   397	        return owner.__dict__[name]
   398	    return getattr(owner, name)
   399	
   400	
   401	def live_chain(value: object, root: Path) -> list[dict]:
   402	    """Describe ``value`` and every level beneath it; raise if unidentifiable."""
   403	    chain: list[dict] = []
   404	    seen: set[int] = set()
   405	    current = value
   406	    while current is not None:
   407	        if id(current) in seen:
   408	            raise Undescribable("cyclic wrapper chain")
   409	        seen.add(id(current))
   410	        entry, current = _level(current, root)
   411	        chain.append(entry)
   412	    return chain
   413	
   414	
   415	def binding_mode() -> str:
   416	    try:
   417	        import torch
   418	    except ImportError:
   419	        return "cpu"
   420	    return "cuda" if torch.cuda.is_available() else "cpu"
   421	
   422	
   423	# Records ------------------------------------------------------------------------
   424	
   425	
   426	def resolve_file(source_root: str | Path, target: str) -> tuple[str, str]:
   427	    """Map ``pkg.module.Qual.name`` to (relative module file, qualname) by path."""
   428	    root = Path(source_root)
   429	    parts = target.split(".")
   430	    for cut in range(len(parts) - 1, 0, -1):
   431	        stem = Path(*parts[:cut])
   432	        for candidate in (stem.with_suffix(".py"), stem / "__init__.py"):
   433	            if (root / candidate).is_file():
   434	                return candidate.as_posix(), ".".join(parts[cut:])
   435	    raise LookupError(f"No module file under {root} for {target}")
   436	
   437	
   438	def record(source_root: str | Path, target: str, previous: dict | None = None) -> dict:
   439	    """Pinned record of ``target`` in the current binding mode.
   440	
   441	    Imports ``target`` from ``source_root``. Chains recorded earlier for other
   442	    modes are kept when the module bytes are unchanged.
   443	    """
   444	    root = Path(source_root).resolve()
   445	    file, qualname = resolve_file(root, target)
   446	    module_name = target[: -len(qualname) - 1]
   447	    imported = sys.modules.get(module_name) or importlib.import_module(module_name)
   448	    if Path(imported.__file__).resolve() != root / file:
   449	        raise LookupError(
   450	            f"{module_name} imports from {imported.__file__}, not {root / file}; "
   451	            "put the pinned checkout first on sys.path"
   452	        )
   453	    data = {"file": file, **definition_record(root / file, qualname)}
   454	    chains = {}
   455	    if (
   456	        previous
   457	        and previous.get("module_sha256") == data["module_sha256"]
   458	        and previous.get("chain_format") == CHAIN_FORMAT
   459	    ):
   460	        chains.update(previous.get("chains", {}))
   461	    chains[binding_mode()] = live_chain(raw_attribute(target), root)
   462	    data["chain_format"] = CHAIN_FORMAT
   463	    data["chains"] = dict(sorted(chains.items()))
   464	    return data
   465	
   466	
   467	def installed_source_root() -> Path:
   468	    import sglang  # Already imported whenever SGLang loads this plugin.
   469	
   470	    return Path(sglang.__file__).resolve().parent.parent
   471	
   472	
   473	def load_pinned() -> dict[str, dict]:
   474	    pinned: dict[str, dict] = {}
   475	    directory = resources.files("sglang_qsa_hisparse").joinpath("fingerprints")
   476	    for entry in sorted(directory.iterdir(), key=lambda e: e.name):
   477	        if not entry.name.endswith(".json"):
   478	            continue
   479	        for target, data in json.loads(entry.read_text(encoding="utf-8")).items():
   480	            if target in pinned and pinned[target] != data:
   481	                raise FingerprintMismatch(f"{target}: conflicting pinned records")
   482	            pinned[target] = data
   483	    return pinned
   484	
   485	
   486	def verify(
   487	    names: list[str],
   488	    *,
   489	    source_root: str | Path | None = None,
   490	    pinned: dict[str, dict] | None = None,
   491	    check_bindings: bool = True,
   492	) -> dict[str, dict]:
   493	    """Check module bytes and live bindings of ``names`` against the pin.
   494	
   495	    Raises FingerprintMismatch on a missing record, different module bytes,
   496	    or a live binding chain that differs from the pinned one.
   497	    """
   498	    root = installed_source_root() if source_root is None else Path(source_root)
   499	    pinned = load_pinned() if pinned is None else pinned
   500	    problems = []
   501	    records = {}
   502	    for name in names:
   503	        expected = pinned.get(name)
   504	        if expected is None:
   505	            problems.append(f"{name}: no pinned fingerprint")
   506	            continue
   507	        try:
   508	            actual = definition_record(root / expected["file"], expected["qualname"])
   509	        except (LookupError, OSError, SyntaxError) as error:
   510	            problems.append(f"{name}: {error}")
   511	            continue
   512	        if actual["module_sha256"] != expected["module_sha256"]:
   513	            changed = "definition" if actual["sha256"] != expected["sha256"] else "module"
   514	            problems.append(f"{name}: {changed} differs from the pinned revision")
   515	            continue
   516	        if check_bindings:
   517	            mode = binding_mode()
   518	            if expected.get("chain_format") != CHAIN_FORMAT:
   519	                problems.append(f"{name}: binding chain format is stale; refresh records")
   520	                continue
   521	            pinned_chain = expected.get("chains", {}).get(mode)
   522	            if pinned_chain is None:
   523	                problems.append(f"{name}: no pinned binding chain for mode {mode}")
   524	                continue
   525	            try:
   526	                owner_path, member = name.rsplit(".", 1)
   527	                owner = pkgutil.resolve_name(owner_path)
   528	                chain = live_chain(raw_attribute(name), root)
   529	            except (AttributeError, ImportError, ValueError, LookupError) as error:
   530	                problems.append(f"{name}: cannot resolve live binding: {error!r}")
   531	                continue
   532	            if isinstance(owner, type) and member not in owner.__dict__:
   533	                problems.append(
   534	                    f"{name}: inherited, not defined on {owner.__qualname__}; "
   535	                    "live binding is not the pinned definition"
   536	                )
   537	                continue
   538	            if chain != pinned_chain:
   539	                problems.append(f"{name}: live binding is not the pinned definition")
   540	                continue
   541	        records[name] = expected
   542	    if problems:
   543	        raise FingerprintMismatch("; ".join(problems))
   544	    return records


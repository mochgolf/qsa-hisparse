   370	    source = HookSource(plugin_name=PLUGIN_NAME, dist_name=DIST_NAME)
   371	    for spec in specs:
   372	        HookRegistry.register(
   373	            spec.target, spec.hook, HookType(spec.hook_type), source=source
   374	        )
   375	    # Apply only this plugin's targets (class REPLACE first, as the registry
   376	    # does); other plugins' entries are left for load_plugins()'s final pass.
   377	    # The registry's own apply loop logs and skips failures; this does not.
   378	    for target in targets:

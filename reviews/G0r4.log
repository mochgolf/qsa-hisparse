   334	def activate(features: Features) -> list[PatchSpec]:
   335	    """Apply all patches for ``features`` exactly once per process."""
   336	    global _activated
   337	    if _activated is not None:
   338	        if _activated != features:
   339	            raise PluginActivationError(
   340	                f"Already activated with {_activated}, requested {features}"

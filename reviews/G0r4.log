   415	def verify_final(role: str, **details: object) -> None:
   416	    """Re-check activation after every plugin registered; record the result."""
   417	    if _activated is None:
   418	        raise PluginActivationError("verify_final called before activation")
   419	    from sglang.srt.plugins.hook_registry import HookRegistry
   420	
   421	    targets = set(_applied) | {a.target for a in _attached_live} | set(_frozen_depends)
   422	    overlap = _foreign_overlaps(HookRegistry, targets)
   423	    if overlap:
   424	        raise PluginActivationError(
   425	            f"Other plugins registered overlapping hooks after activation: {overlap}"
   426	        )
   427	    late = sorted(
   428	        key
   429	        for key, hooks in HookRegistry._hooks.items()
   430	        if tuple(hooks) != _frozen_hooks.get(key, tuple(hooks))
   431	        or (
   432	            key not in _frozen_hooks
   433	            and any(h[2] is not None and h[2].plugin_name == PLUGIN_NAME for h in hooks)
   434	            # Any entry claiming this plugin's name after activation is late.
   435	        )
   436	    )
   437	    if late:
   438	        raise PluginActivationError(f"Hooks registered after activation: {late}")
   439	    frozen = {**_frozen_depends, **_applied}
   440	    changed = sorted(t for t, live in frozen.items() if _raw_attribute(t) is not live)
   441	    if changed:
   442	        raise PluginActivationError(
   443	            f"Patched targets or dependencies were replaced afterwards: {changed}"
   444	        )
   445	    _verify_attached(_attached_live)
   446	    mutated = sorted(name for name, (obj, desc) in _snapshots.items() if _describe(obj) != desc)
   447	    if mutated:
   448	        raise PluginActivationError(f"Protected bindings changed in place: {mutated}")
   449	
   450	    directory = os.environ.get(ACTIVATION_DIR_ENV)
   451	    if directory:
   452	        record = {
   453	            "pid": os.getpid(),
   454	            "role": role,
   455	            "features": list(_activated.active),
   456	            "hisparse_mode": _activated.hisparse_mode,
   457	            "patches": sorted(_applied),
   458	            "attached": sorted(a.target for a in _attached_live),
   459	            "pinned_sglang_commit": PINNED_SGLANG_COMMIT,
   460	            **details,
   461	        }
   462	        path = Path(directory) / f"{role}-{os.getpid()}.json"
   463	        path.parent.mkdir(parents=True, exist_ok=True)
   464	        path.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n")


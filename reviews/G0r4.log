   248	    class_replaced = {
   249	        s.target for s in specs if s.hook_type == "replace" and isinstance(s.hook, type)
   250	    }
   251	    nested = sorted(
   252	        s.target for s in specs for owner in class_replaced if s.target.startswith(owner + ".")
   253	    )
   254	    if nested:
   255	        raise PluginActivationError(
   256	            f"Hooks on members of a replaced class (implement them in the "
   257	            f"replacement class instead): {nested}"

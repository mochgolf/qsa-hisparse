   348	    names |= {d for s in attaches for d in s.depends}
   349	    unchecked = {n for s in specs for n in s.unchecked_bindings}
   350	    fingerprint.verify(sorted(names - unchecked))
   351	    fingerprint.verify(sorted(names & unchecked), check_bindings=False)
   352	    properties = sorted(s.target for s in specs if isinstance(_raw_attribute(s.target), property))
   353	    if properties:
   354	        raise PluginActivationError(f"Properties cannot be hook targets: {properties}")

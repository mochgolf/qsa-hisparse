   260	    duplicates = sorted({t for t in attached if attached.count(t) > 1})
   261	    if duplicates:
   262	        raise PluginActivationError(f"Members attached twice: {duplicates}")
   263	    hooked = sorted(set(attached) & {spec.target for spec in specs})
   264	    if hooked:
   265	        raise PluginActivationError(f"Hooks on attached members: {hooked}")

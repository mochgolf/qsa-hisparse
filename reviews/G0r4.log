   270	def _raw_attribute(target: str):
   271	    return fingerprint.raw_attribute(target)
   272	
   273	
   274	def _source():
   275	    from sglang.srt.plugins.hook_registry import HookSource
   276	
   277	    return HookSource(plugin_name=PLUGIN_NAME, dist_name=DIST_NAME)
   278	
   279	
   280	def _foreign_overlaps(registry, targets: set[str]) -> list[str]:
   281	    """Registry keys overlapping ``targets`` with any hook not exactly ours."""
   282	    ours = _source()
   283	    found = []
   284	    for key, hooks in registry._hooks.items():
   285	        foreign = [h for h in hooks if h[2] != ours]
   286	        if foreign and any(_overlaps(key, target) for target in targets):
   287	            found.append(key)
   288	    return sorted(found)
   289	
   290	
   291	def _existing_entries(registry, names: set[str]) -> list[str]:
   292	    """Registry keys overlapping ``names`` with any hook, from any source."""
   293	    return sorted(
   294	        key
   295	        for key, hooks in registry._hooks.items()
   296	        if hooks and any(_overlaps(key, name) for name in names)
   297	    )
   298	
   299	
   300	def _describe(value: object) -> object:
   301	    """Recomputable description of an object (identity if unidentifiable)."""
   302	    try:
   303	        return ("chain", fingerprint.live_chain(value, fingerprint.installed_source_root()))
   304	    except fingerprint.Undescribable:
   305	        return ("identity", id(value))
   306	
   307	
   308	def _defines(owner: object, name: str) -> bool:
   309	    if isinstance(owner, type):
   310	        return any(name in klass.__dict__ for klass in owner.__mro__)
   311	    return hasattr(owner, name)
   312	
   313	
   314	def _attach_all(attaches: list[AttachSpec]) -> None:
   315	    owners = {spec.owner: pkgutil.resolve_name(spec.owner) for spec in attaches}
   316	    present = [spec.target for spec in attaches if _defines(owners[spec.owner], spec.name)]
   317	    if present:
   318	        raise PluginActivationError(
   319	            f"Attach targets already defined upstream (pin drift): {present}"
   320	        )
   321	    for spec in attaches:
   322	        setattr(owners[spec.owner], spec.name, spec.value)

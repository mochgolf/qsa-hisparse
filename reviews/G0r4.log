   221	    extra = sorted((declared - expected).elements())
   222	    if missing or extra:
   223	        raise PluginActivationError(
   224	            f"Declarations differ from manifest.json; missing {missing}; "
   225	            f"undeclared in manifest {extra}"
   226	        )

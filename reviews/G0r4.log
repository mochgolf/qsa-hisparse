   234	    specs = [spec for spec in _declared if spec.feature in wanted]
   235	    attaches = [spec for spec in _attached if spec.feature in wanted]
   236	
   237	    keys = [(s.feature, s.row, s.target, s.hook_type) for s in specs]
   238	    repeated = sorted({k for k in keys if keys.count(k) > 1})
   239	    if repeated:
   240	        raise PluginActivationError(f"Hooks declared more than once: {repeated}")
   241	    replaced: set[str] = set()
   242	    for spec in specs:
   243	        if spec.hook_type != "replace":
   244	            continue
   245	        if spec.target in replaced:
   246	            raise PluginActivationError(f"Two REPLACE patches on {spec.target}")

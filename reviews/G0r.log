   460	def test_entry_point_import_failure_stops_the_process(tmp_path):
   461	    prelude = textwrap.dedent(
   462	        """
   463	        import sglang_qsa_hisparse.patching as patching
   464	        def broken(feature):
   465	            raise ModuleNotFoundError("injected patch module import failure")
   466	        patching._import_feature_modules = broken
   467	        """
   468	    )
   469	    result = _run_loader(tmp_path, {"SGLANG_QSA_MODEL_COMPAT": "1"}, prelude)
   470	    assert result.returncode != 0
   471	    assert "PluginActivationError" in result.stderr
   472	    assert "injected patch module import failure" in result.stderr
   473	    assert "hooks" not in result.stdout

    38	def delta(value, reference):
    39	    difference = (value.float() - reference.float()).abs()
    40	    return dict(
    41	        bitwise_equal=digest(value) == digest(reference),
    42	        changed_elements=int((value != reference).sum()),
    43	        max_abs_delta=float(difference.max()),

   446	def test_entry_point_activates_on_the_pin(tmp_path):
   447	    result = _run_loader(tmp_path, {"SGLANG_QSA_MODEL_COMPAT": "1"})
   448	    assert result.returncode == 0, result.stderr
   449	    assert "sglang.srt.managers.scheduler.Scheduler.__init__" in result.stdout
   450	    assert "patching True" in result.stdout

   185	def test_activate_applies_and_verifies(registry, fake_sglang, monkeypatch):
   186	    _use_pin(monkeypatch, fake_sglang, "qsa_fake.mod.double", "qsa_fake.mod.Box.value")
   187	
   188	    @patching.patch("qsa_fake.mod.double", "around", feature="model_compat")
   189	    def triple(original, x):
   190	        return original(x) + x
   191	
   192	    @patching.patch(
   193	        "qsa_fake.mod.Box.value",
   194	        "replace",
   195	        feature="hisparse",
   196	        depends=("qsa_fake.mod.double",),
   197	    )
   198	    def value(self):
   199	        return 7
   200	
   201	    specs = patching.activate(Features(model_compat=True))
   202	    import qsa_fake.mod as mod
   203	
   204	    assert [spec.target for spec in specs] == ["qsa_fake.mod.double"]
   205	    assert mod.double(2) == 6
   206	    assert mod.Box().value() == 1  # hisparse was not requested.
   207	    assert patching.activate(Features(model_compat=True)) == specs

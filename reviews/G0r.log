   123	
   124	def resolve_file(source_root: str | Path, target: str) -> tuple[str, str]:
   125	    """Map ``pkg.module.Qual.name`` to (relative module file, qualname) by path."""
   126	    root = Path(source_root)
   127	    parts = target.split(".")
   128	    for cut in range(len(parts) - 1, 0, -1):
   129	        stem = Path(*parts[:cut])
   130	        for candidate in (stem.with_suffix(".py"), stem / "__init__.py"):
   131	            if (root / candidate).is_file():
   132	                return candidate.as_posix(), ".".join(parts[cut:])
   133	    raise LookupError(f"No module file under {root} for {target}")
   134	
   135	
   136	def record(source_root: str | Path, target: str) -> dict:
   137	    file, qualname = resolve_file(source_root, target)
   138	    return {"file": file, **definition_record(Path(source_root) / file, qualname)}
   139	
   140	
   141	def installed_source_root() -> Path:
   142	    import sglang  # Already imported whenever SGLang loads this plugin.
   143	
   144	    return Path(sglang.__file__).resolve().parent.parent
   145	
   146	
   147	def load_pinned() -> dict[str, dict]:
   148	    pinned: dict[str, dict] = {}
   149	    directory = resources.files("sglang_qsa_hisparse").joinpath("fingerprints")
   150	    for entry in sorted(directory.iterdir(), key=lambda e: e.name):
   151	        if not entry.name.endswith(".json"):
   152	            continue
   153	        for target, data in json.loads(entry.read_text(encoding="utf-8")).items():
   154	            if target in pinned and pinned[target] != data:
   155	                raise FingerprintMismatch(f"{target}: conflicting pinned records")
   156	            pinned[target] = data
   157	    return pinned
   158	
   159	
   160	def verify(
   161	    names: list[str],
   162	    *,
   163	    source_root: str | Path | None = None,
   164	    pinned: dict[str, dict] | None = None,
   165	) -> dict[str, dict]:
   166	    """Return the pinned records of ``names`` after checking their modules.
   167	
   168	    Raises FingerprintMismatch if a name has no record or the bytes of its
   169	    module (and therefore its definition) differ from the pinned revision.
   170	    """
   171	    root = installed_source_root() if source_root is None else Path(source_root)
   172	    pinned = load_pinned() if pinned is None else pinned
   173	    problems = []
   174	    records = {}
   175	    for name in names:
   176	        expected = pinned.get(name)
   177	        if expected is None:
   178	            problems.append(f"{name}: no pinned fingerprint")
   179	            continue
   180	        try:
   181	            actual = definition_record(root / expected["file"], expected["qualname"])
   182	        except (LookupError, OSError, SyntaxError) as error:
   183	            problems.append(f"{name}: {error}")
   184	            continue
   185	        if actual["module_sha256"] != expected["module_sha256"]:
   186	            changed = "definition" if actual["sha256"] != expected["sha256"] else "module"
   187	            problems.append(f"{name}: {changed} differs from the pinned revision")
   188	            continue
   189	        records[name] = {**expected, "path": str(root / expected["file"])}
   190	    if problems:
   191	        raise FingerprintMismatch("; ".join(problems))
   192	    return records

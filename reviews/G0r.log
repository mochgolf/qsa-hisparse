    47	def fixture(
    48	    m, row, pattern, e, topk, target_x, target_down, target_ids, target_weights
    49	):
    50	    gen = torch.Generator().manual_seed(66107 + m)
    51	    x = (torch.randn(m, target_x.numel(), generator=gen) / 3).bfloat16()
    52	    down = (torch.randn(m, topk, target_down.shape[-1], generator=gen) / 3).bfloat16()
    53	    ids = torch.argsort(torch.rand(m, e, generator=gen), dim=1)[:, :topk].int()
    54	    weights = torch.rand(m, topk, generator=gen)
    55	    weights /= weights.sum(dim=1, keepdim=True)
    56	    if pattern in ("identical", "same_routes"):
    57	        ids[:] = target_ids
    58	        weights[:] = target_weights
    59	    if pattern == "identical":
    60	        x[:] = target_x
    61	        down[:] = target_down
    62	    if pattern == "shifted_routes":
    63	        # Move the target's expert blocks in the flattened expert ordering.
    64	        ids = (
    65	            torch.arange(topk).unsqueeze(0) + torch.arange(m).unsqueeze(1) * topk
    66	        ) % e
    67	        ids = ids.int()
    68	    x[row], down[row], ids[row], weights[row] = (
    69	        target_x,
    70	        target_down,
    71	        target_ids,
    72	        target_weights,
    73	    )
    74	    assert torch.equal(x[row], target_x) and torch.equal(down[row], target_down)
    75	    assert torch.equal(ids[row], target_ids) and torch.equal(
    76	        weights[row], target_weights
    77	    )
    78	    assert all(len(set(r.tolist())) == topk for r in ids)
    79	    return x, down, ids, weights

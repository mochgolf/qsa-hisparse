   404	# Real SGLang loader in a fresh process --------------------------------------
   405	
   406	
   407	def _run_loader(tmp_path, environ, prelude=""):
   408	    dist = tmp_path / "sglang_qsa_hisparse-0.1.0.dev0.dist-info"
   409	    dist.mkdir(exist_ok=True)
   410	    (dist / "METADATA").write_text(
   411	        "Metadata-Version: 2.1\nName: sglang-qsa-hisparse\nVersion: 0.1.0.dev0\n"
   412	    )
   413	    (dist / "entry_points.txt").write_text(
   414	        "[sglang.srt.plugins]\nqsa_hisparse = sglang_qsa_hisparse.plugin:load\n"
   415	    )
   416	    code = prelude + textwrap.dedent(
   417	        """
   418	        import sys
   419	        from sglang.srt.plugins import load_plugins
   420	        from sglang.srt.plugins.hook_registry import HookRegistry
   421	        load_plugins()
   422	        print("hooks", sorted(HookRegistry._hooks))
   423	        print("patched", sorted(HookRegistry._patched))
   424	        print("patching", "sglang_qsa_hisparse.patching" in sys.modules)
   425	        """
   426	    )
   427	    env = {
   428	        key: value
   429	        for key, value in os.environ.items()
   430	        if not key.startswith("SGLANG_QSA_") and key != "SGLANG_PLUGINS"
   431	    }
   432	    env.update(environ)
   433	    env["PYTHONPATH"] = f"{tmp_path}{os.pathsep}{env.get('PYTHONPATH', '')}"
   434	    return subprocess.run(
   435	        [sys.executable, "-c", code], env=env, capture_output=True, text=True
   436	    )
   437	
   438	
   439	def test_entry_point_is_noop_when_off(tmp_path):
   440	    result = _run_loader(tmp_path, {})
   441	    assert result.returncode == 0, result.stderr
   442	    assert "hooks []" in result.stdout
   443	    assert "patching False" in result.stdout
   444	

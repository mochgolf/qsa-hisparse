   454	    result = _run_loader(tmp_path, {"SGLANG_QSA_HISPARSE_V3": "p2-offload"})
   455	    assert result.returncode != 0
   456	    assert "PluginConfigError" in result.stderr
   457	    assert "hooks" not in result.stdout

     1	"""Source fingerprints of patch targets, computed without importing them.
     2	
     3	Activation is gated on the raw bytes of every module that contains a patch
     4	target or a declared dependency: the plugin is pinned to one SGLang commit,
     5	so any edit to such a module fails closed, including new conditional
     6	redefinitions, module constants, helpers, line endings and indentation.
     7	
     8	Each record also hashes the definition itself (raw bytes, decorators, and
     9	the decorator/header lines of every enclosing class) for upgrade
    10	diagnostics, and stores its line numbers so activation can check that the
    11	live object is the definition that was fingerprinted. Writing a record
    12	requires exactly one binding of each name along the qualified path.
    13	
    14	Pinned records live in ``fingerprints/*.json`` (one file per patch module,
    15	so parallel work does not share a file) and map a dotted target to
    16	``{"file", "qualname", "kind", "first_line", "def_line", "sha256",
    17	"module_sha256"}``.
    18	"""
    19	
    20	import ast
    21	import hashlib
    22	import json
    23	from importlib import resources
    24	from pathlib import Path
    25	
    26	from sglang_qsa_hisparse.errors import FingerprintMismatch
    27	
    28	_DEFINITIONS = (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)
    29	_SCOPES = (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef, ast.Lambda)
    30	
    31	
    32	def _sha256(data: bytes) -> str:
    33	    return hashlib.sha256(data).hexdigest()
    34	
    35	
    36	def _bound_names(statement: ast.stmt) -> list[str]:
    37	    names: list[str] = []
    38	    if isinstance(statement, _DEFINITIONS):
    39	        names.append(statement.name)
    40	    elif isinstance(statement, (ast.Import, ast.ImportFrom)):
    41	        for alias in statement.names:
    42	            names.append(alias.asname or alias.name.split(".")[0])
    43	    else:
    44	        targets: list[ast.AST] = []
    45	        if isinstance(statement, ast.Assign):
    46	            targets = list(statement.targets)
    47	        elif isinstance(statement, (ast.AnnAssign, ast.AugAssign)):
    48	            targets = [statement.target]
    49	        elif isinstance(statement, ast.Delete):
    50	            targets = list(statement.targets)
    51	        elif isinstance(statement, (ast.For, ast.AsyncFor)):
    52	            targets = [statement.target]
    53	        elif isinstance(statement, (ast.With, ast.AsyncWith)):
    54	            targets = [i.optional_vars for i in statement.items if i.optional_vars]
    55	        for target in targets:
    56	            for node in ast.walk(target):
    57	                if isinstance(node, ast.Name):
    58	                    names.append(node.id)
    59	    return names
    60	
    61	
    62	def _statements(scope: ast.AST):
    63	    """Statements executed in ``scope``, entering compound statements only."""
    64	    pending = list(getattr(scope, "body", ()))
    65	    while pending:
    66	        statement = pending.pop()
    67	        yield statement
    68	        if isinstance(statement, _SCOPES):
    69	            continue
    70	        for field in ("body", "orelse", "finalbody", "handlers", "cases"):
    71	            for child in getattr(statement, field, ()) or ():
    72	                if isinstance(child, (ast.ExceptHandler, ast.match_case)):
    73	                    pending.extend(child.body)
    74	                else:
    75	                    pending.append(child)
    76	
    77	
    78	def _locate(tree: ast.Module, qualname: str) -> tuple[ast.AST, list[ast.ClassDef]]:
    79	    node: ast.AST = tree
    80	    enclosing: list[ast.ClassDef] = []
    81	    for part in qualname.split("."):
    82	        bindings = [s for s in _statements(node) if part in _bound_names(s)]
    83	        direct = [
    84	            child
    85	            for child in getattr(node, "body", ())
    86	            if isinstance(child, _DEFINITIONS) and child.name == part
    87	        ]
    88	        if len(bindings) != 1 or len(direct) != 1:
    89	            raise LookupError(
    90	                f"{qualname}: {part!r} must have exactly one binding, a direct "
    91	                f"definition; found {len(bindings)} binding(s), {len(direct)} direct"
    92	            )
    93	        if isinstance(node, ast.ClassDef):
    94	            enclosing.append(node)
    95	        node = direct[0]
    96	    return node, enclosing
    97	
    98	
    99	def _first_line(node: ast.AST) -> int:
   100	    return min([node.lineno] + [d.lineno for d in node.decorator_list])
   101	
   102	
   103	def _header(lines: list[bytes], klass: ast.ClassDef) -> bytes:
   104	    return b"".join(lines[_first_line(klass) - 1 : klass.body[0].lineno - 1])
   105	
   106	
   107	def definition_record(path: str | Path, qualname: str) -> dict:
   108	    data = Path(path).read_bytes()
   109	    node, enclosing = _locate(ast.parse(data), qualname)
   110	    lines = data.splitlines(keepends=True)
   111	    first = _first_line(node)
   112	    segment = b"".join(_header(lines, k) for k in enclosing)
   113	    segment += b"".join(lines[first - 1 : node.end_lineno])
   114	    return {
   115	        "qualname": qualname,
   116	        "kind": "class" if isinstance(node, ast.ClassDef) else "function",
   117	        "first_line": first,
   118	        "def_line": node.lineno,
   119	        "sha256": _sha256(segment),
   120	        "module_sha256": _sha256(data),
   121	    }

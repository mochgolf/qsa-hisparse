   222	def build_pending_ring_slots(
   223	    *,
   224	    token_to_batch_idx: torch.Tensor,
   225	    req_pool_indices: torch.Tensor,
   226	    sequence_lengths: torch.Tensor,
   227	    logical_positions: torch.Tensor,
   228	    compress_ratio: int,
   229	    is_extend: bool,
   230	) -> torch.Tensor:
   231	    """Pending-ring slot ``req_pool_idx * ratio + position % ratio`` per token.
   232	    On extend, tokens before the pending tail dump into rows [0, ratio),
   233	    which no request owns (request slot 0 is never allocated); CUDA-graph safe."""
   234	    rows = token_to_batch_idx.long()[: logical_positions.numel()]
   235	    requests = req_pool_indices.long()[rows]
   236	    positions = logical_positions.long()
   237	    slots = requests * compress_ratio + positions % compress_ratio
   238	    if is_extend:
   239	        lengths = sequence_lengths.long()[rows]
   240	        pending = positions >= (lengths // compress_ratio) * compress_ratio
   241	        slots = torch.where(pending, slots, positions % compress_ratio)
   242	    return slots

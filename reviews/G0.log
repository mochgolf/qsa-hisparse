    52	def resolve_file(source_root: str | Path, target: str) -> tuple[str, str]:
    53	    """Map ``pkg.module.Qual.name`` to (relative module file, qualname) by path."""
    54	    root = Path(source_root)
    55	    parts = target.split(".")
    56	    for cut in range(len(parts) - 1, 0, -1):
    57	        stem = Path(*parts[:cut])
    58	        for candidate in (stem.with_suffix(".py"), stem / "__init__.py"):
    59	            if (root / candidate).is_file():
    60	                return candidate.as_posix(), ".".join(parts[cut:])
    61	    raise LookupError(f"No module file under {root} for {target}")

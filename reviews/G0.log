    23	_DEFINITIONS = (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)
    24	
    25	
    26	def _locate(tree: ast.Module, qualname: str) -> ast.AST:
    27	    node: ast.AST = tree
    28	    for part in qualname.split("."):
    29	        matches = [
    30	            child
    31	            for child in getattr(node, "body", ())
    32	            if isinstance(child, _DEFINITIONS) and child.name == part
    33	        ]
    34	        if len(matches) != 1:
    35	            raise LookupError(
    36	                f"{qualname}: expected one definition of {part!r} directly in "
    37	                f"its parent, found {len(matches)}"
    38	            )
    39	        node = matches[0]
    40	    return node
    41	
    42	
    43	def source_fingerprint(path: str | Path, qualname: str) -> str:
    44	    text = Path(path).read_text(encoding="utf-8")
    45	    node = _locate(ast.parse(text), qualname)
    46	    start = min([node.lineno] + [d.lineno for d in node.decorator_list])
    47	    lines = text.splitlines()[start - 1 : node.end_lineno]
    48	    segment = textwrap.dedent("\n".join(lines))
    49	    return hashlib.sha256(segment.encode("utf-8")).hexdigest()

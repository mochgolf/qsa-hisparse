   238	    """Run SGLang's real entry-point loader in a fresh process."""
   239	    dist = tmp_path / "sglang_qsa_hisparse-0.1.0.dev0.dist-info"
   240	    dist.mkdir(exist_ok=True)
   241	    (dist / "METADATA").write_text(
   242	        "Metadata-Version: 2.1\nName: sglang-qsa-hisparse\nVersion: 0.1.0.dev0\n"
   243	    )
   244	    (dist / "entry_points.txt").write_text(
   245	        "[sglang.srt.plugins]\nqsa_hisparse = sglang_qsa_hisparse.plugin:load\n"
   246	    )
   247	    code = textwrap.dedent(
   248	        """
   249	        import sys
   250	        from sglang.srt.plugins import load_plugins
   251	        from sglang.srt.plugins.hook_registry import HookRegistry
   252	        load_plugins()
   253	        print("hooks", len(HookRegistry._hooks))
   254	        print("patching", "sglang_qsa_hisparse.patching" in sys.modules)
   255	        """
   256	    )
   257	    env = {
   258	        key: value
   259	        for key, value in os.environ.items()
   260	        if not key.startswith("SGLANG_QSA_") and key != "SGLANG_PLUGINS"
   261	    }
   262	    env.update(environ)
   263	    env["PYTHONPATH"] = f"{tmp_path}{os.pathsep}{env.get('PYTHONPATH', '')}"
   264	    return subprocess.run(
   265	        [sys.executable, "-c", code], env=env, capture_output=True, text=True
   266	    )
   267	
   268	
   269	def test_entry_point_is_noop_when_off(tmp_path):
   270	    result = _run_loader(tmp_path, {})
   271	    assert result.returncode == 0, result.stderr
   272	    assert "hooks 0" in result.stdout
   273	    assert "patching False" in result.stdout
   274	
   275	
   276	def test_entry_point_failure_stops_the_process(tmp_path):
   277	    result = _run_loader(tmp_path, {"SGLANG_QSA_HISPARSE_V3": "p2-offload"})
   278	    assert result.returncode != 0
   279	    assert "PluginConfigError" in result.stderr
   280	    assert "hooks" not in result.stdout


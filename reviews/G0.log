     1	"""Startup contract for the bounded QSA HiSparse execution modes."""
     2	
     3	import os
     4	
     5	import torch
     6	
     7	
     8	def prefix_cache_options():
     9	    try:
    10	        mb = int(os.environ.get("SGLANG_QSA_HISPARSE_PREFIX_CACHE_MB", "0"))
    11	        entries = int(
    12	            os.environ.get("SGLANG_QSA_HISPARSE_PREFIX_CACHE_MAX_ENTRIES", "256")
    13	        )
    14	    except ValueError as error:
    15	        raise ValueError(
    16	            "QSA prefix host budget and entry limit must be integers"
    17	        ) from error
    18	    if mb < 0 or entries <= 0:
    19	        raise ValueError(
    20	            "QSA prefix host budget must be nonnegative and entry limit positive"
    21	        )
    22	    return mb * 1024 * 1024, entries
    23	
    24	
    25	def validate_configuration(args, pool, *, p2=False, graph=False, strict=True):
    26	    budget, _ = prefix_cache_options()
    27	    if budget and not p2:
    28	        raise ValueError("QSA host prefixes require the multi-request offload runtime")
    29	    if graph and not p2:
    30	        raise ValueError("only QSA P2 offload supports the bounded graph path")
    31	    max_requests = getattr(args, "max_running_requests", None) if p2 else 1
    32	    if p2 and max_requests not in (2, 4, 8):
    33	        raise ValueError("QSA P2 requires max_running_requests in (2, 4, 8)")
    34	    required = {
    35	        "max_running_requests": max_requests,
    36	        "tp_size": 2,
    37	        "pp_size": 1,
    38	        "disable_radix_cache": True,
    39	        "disable_overlap_schedule": True,
    40	        "cuda_graph_backend_decode": "full" if graph else "disabled",

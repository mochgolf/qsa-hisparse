   178	                    case["input_ids"],
   179	                    f"{namespace}-cold-{index}-{repeat}",
   180	                    case["max_new_tokens"],
   181	                )
   182	                if row[f"cold_{repeat}"]["cached_tokens"] != 0:
   183	                    raise AssertionError("Unique cache salt unexpectedly hit a prefix")
   184	            if row["cold_0"]["output_ids"] != row["cold_1"]["output_ids"]:
   185	                mismatch(f"Cold repetitions differ: {case['name']}", row)
   186	            if args.command == "qualify":
   187	                salt = f"{namespace}-warm-{case['group']}"
   188	                row["seed"] = generate(args.url, case["prefix_ids"], salt, 1)
   189	                row["warm"] = generate(

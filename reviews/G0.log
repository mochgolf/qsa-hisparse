    63	
    64	def record(source_root: str | Path, target: str) -> dict[str, str]:
    65	    file, qualname = resolve_file(source_root, target)
    66	    return {
    67	        "file": file,
    68	        "qualname": qualname,
    69	        "sha256": source_fingerprint(Path(source_root) / file, qualname),
    70	    }

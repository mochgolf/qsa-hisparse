    27	# Entry point group names
    28	PLATFORM_PLUGINS_GROUP = "sglang.srt.platforms"
    29	GENERAL_PLUGINS_GROUP = "sglang.srt.plugins"
    30	
    31	# Guard against multiple loads in the same process
    32	_plugins_loaded = False

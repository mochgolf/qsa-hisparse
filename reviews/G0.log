   159	        "passed": False,
   160	    }
   161	
   162	    def mismatch(message, row=None):
   163	        report["output_mismatches"].append(message)
   164	        if row is not None:
   165	            row.setdefault("output_mismatches", []).append(message)
   166	        if not args.continue_on_mismatch:
   167	            raise AssertionError(message)

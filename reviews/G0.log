   172	            print(f"{args.command}: {case['name']}", flush=True)
   173	            row = {"name": case["name"], "prefix_length": case["prefix_length"]}
   174	            report["cases"].append(row)
   175	            for repeat in range(2):
   176	                row[f"cold_{repeat}"] = generate(

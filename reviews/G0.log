    29	def main() -> int:
    30	    parser = argparse.ArgumentParser()
    31	    parser.add_argument("--source-root", default=str(Path(DEFAULT_ROOT) / "python"))
    32	    sub = parser.add_subparsers(dest="command", required=True)
    33	    write = sub.add_parser("write")
    34	    write.add_argument("name")
    35	    write.add_argument("targets", nargs="+")
    36	    sub.add_parser("check")
    37	    args = parser.parse_args()
    38	
    39	    if args.command == "write":
    40	        path = OUT / f"{args.name}.json"
    41	        records = json.loads(path.read_text()) if path.exists() else {}
    42	        for target in args.targets:
    43	            records[target] = fingerprint.record(args.source_root, target)
    44	        path.write_text(json.dumps(records, indent=2, sort_keys=True) + "\n")
    45	        print(f"wrote {len(args.targets)} target(s) to {path.relative_to(REPO)}")
    46	        return 0
    47	
    48	    pinned = fingerprint.load_pinned()
    49	    fingerprint.verify(sorted(pinned), source_root=args.source_root, pinned=pinned)
    50	    print(f"{len(pinned)} pinned fingerprint(s) match {args.source_root}")

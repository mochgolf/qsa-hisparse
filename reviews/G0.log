src/sglang_qsa_hisparse/fingerprint.py
     1	"""Source fingerprints of patch targets, computed without importing them.
     2	
     3	A fingerprint is the SHA-256 of a definition's dedented source text,
     4	including decorators, located by qualified name in the parsed module file.
     5	The same routine runs offline against the pinned checkout and at activation
     6	against the installed SGLang, so any upstream edit to a patched definition
     7	fails activation instead of silently mixing old and new code.
     8	
     9	Pinned records live in ``fingerprints/*.json`` (one file per patch module, so
    10	parallel work does not share a file) and map a dotted target to
    11	``{"file": "sglang/...py", "qualname": "...", "sha256": "..."}``.
    12	"""
    13	
    14	import ast
    15	import hashlib
    16	import json
    17	import textwrap
    18	from importlib import resources
    19	from pathlib import Path
    20	
    21	from sglang_qsa_hisparse.errors import FingerprintMismatch
    22	
    23	_DEFINITIONS = (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)
    24	
    25	
    26	def _locate(tree: ast.Module, qualname: str) -> ast.AST:
    27	    node: ast.AST = tree
    28	    for part in qualname.split("."):
    29	        matches = [
    30	            child
    31	            for child in getattr(node, "body", ())
    32	            if isinstance(child, _DEFINITIONS) and child.name == part
    33	        ]
    34	        if len(matches) != 1:
    35	            raise LookupError(
    36	                f"{qualname}: expected one definition of {part!r} directly in "
    37	                f"its parent, found {len(matches)}"
    38	            )
    39	        node = matches[0]
    40	    return node
    41	
    42	
    43	def source_fingerprint(path: str | Path, qualname: str) -> str:
    44	    text = Path(path).read_text(encoding="utf-8")
    45	    node = _locate(ast.parse(text), qualname)
    46	    start = min([node.lineno] + [d.lineno for d in node.decorator_list])
    47	    lines = text.splitlines()[start - 1 : node.end_lineno]
    48	    segment = textwrap.dedent("\n".join(lines))
    49	    return hashlib.sha256(segment.encode("utf-8")).hexdigest()
    50	
    51	
    52	def resolve_file(source_root: str | Path, target: str) -> tuple[str, str]:
    53	    """Map ``pkg.module.Qual.name`` to (relative module file, qualname) by path."""
    54	    root = Path(source_root)
    55	    parts = target.split(".")
    56	    for cut in range(len(parts) - 1, 0, -1):
    57	        stem = Path(*parts[:cut])
    58	        for candidate in (stem.with_suffix(".py"), stem / "__init__.py"):
    59	            if (root / candidate).is_file():
    60	                return candidate.as_posix(), ".".join(parts[cut:])
    61	    raise LookupError(f"No module file under {root} for {target}")
    62	
    63	
    64	def record(source_root: str | Path, target: str) -> dict[str, str]:
    65	    file, qualname = resolve_file(source_root, target)
    66	    return {
    67	        "file": file,
    68	        "qualname": qualname,
    69	        "sha256": source_fingerprint(Path(source_root) / file, qualname),
    70	    }
    71	
    72	
    73	def installed_source_root() -> Path:
    74	    import sglang  # Already imported whenever SGLang loads this plugin.
    75	
    76	    return Path(sglang.__file__).resolve().parent.parent
    77	
    78	
    79	def load_pinned() -> dict[str, dict[str, str]]:
    80	    pinned: dict[str, dict[str, str]] = {}
    81	    directory = resources.files("sglang_qsa_hisparse").joinpath("fingerprints")
    82	    for entry in sorted(directory.iterdir(), key=lambda e: e.name):
    83	        if not entry.name.endswith(".json"):
    84	            continue
    85	        for target, data in json.loads(entry.read_text(encoding="utf-8")).items():
    86	            if target in pinned and pinned[target] != data:
    87	                raise FingerprintMismatch(f"{target}: conflicting pinned records")
    88	            pinned[target] = data
    89	    return pinned
    90	
    91	
    92	def verify(
    93	    names: list[str],
    94	    *,
    95	    source_root: str | Path | None = None,
    96	    pinned: dict[str, dict[str, str]] | None = None,
    97	) -> None:
    98	    """Raise FingerprintMismatch unless every named definition matches the pin."""
    99	    root = installed_source_root() if source_root is None else Path(source_root)
   100	    pinned = load_pinned() if pinned is None else pinned
   101	    problems = []
   102	    for name in names:
   103	        expected = pinned.get(name)
   104	        if expected is None:
   105	            problems.append(f"{name}: no pinned fingerprint")
   106	            continue
   107	        try:
   108	            actual = source_fingerprint(root / expected["file"], expected["qualname"])
   109	        except (LookupError, OSError, SyntaxError) as error:
   110	            problems.append(f"{name}: {error}")
   111	            continue
   112	        if actual != expected["sha256"]:
   113	            problems.append(f"{name}: source differs from the pinned revision")
   114	    if problems:
   115	        raise FingerprintMismatch("; ".join(problems))
src/sglang_qsa_hisparse/errors.py
     1	"""Activation failures that SGLang's plugin loader cannot swallow.
     2	
     3	``sglang.srt.plugins.load_plugins`` and ``HookRegistry.apply_hooks`` catch
     4	``Exception`` and only log it. A requested feature that fails to activate
     5	must stop the process instead of serving unpatched upstream behavior, so
     6	activation errors derive from ``BaseException``.
     7	"""
     8	
     9	
    10	class PluginActivationError(BaseException):
    11	    """A requested feature could not be activated exactly as pinned."""
    12	
    13	
    14	class PluginConfigError(PluginActivationError):
    15	    """Feature switches are malformed or form an unsupported combination."""
    16	
    17	
    18	class FingerprintMismatch(PluginActivationError):
    19	    """A patch target's source differs from the pinned SGLang revision."""
tools/fingerprint.py
     1	#!/usr/bin/env python3
     2	"""Generate or check pinned fingerprints for patch targets.
     3	
     4	    tools/fingerprint.py write <name> <target>...   # fingerprints/<name>.json
     5	    tools/fingerprint.py check                      # every pinned record
     6	
     7	Fingerprints are always taken from the pinned checkout (``--source-root``,
     8	default ``$QSA_PIN_ROOT/python``), never from the reference fork.
     9	"""
    10	
    11	import argparse
    12	import json
    13	import os
    14	import sys
    15	from pathlib import Path
    16	
    17	REPO = Path(__file__).resolve().parents[1]
    18	sys.path.insert(0, str(REPO / "src"))
    19	
    20	from sglang_qsa_hisparse import fingerprint  # noqa: E402
    21	
    22	DEFAULT_ROOT = os.environ.get(
    23	    "QSA_PIN_ROOT",
    24	    str(REPO.parent / ".worktrees" / "sglang-pin-76e06febab"),
    25	)
    26	OUT = REPO / "src" / "sglang_qsa_hisparse" / "fingerprints"
    27	
    28	
    29	def main() -> int:
    30	    parser = argparse.ArgumentParser()
    31	    parser.add_argument("--source-root", default=str(Path(DEFAULT_ROOT) / "python"))
    32	    sub = parser.add_subparsers(dest="command", required=True)
    33	    write = sub.add_parser("write")
    34	    write.add_argument("name")
    35	    write.add_argument("targets", nargs="+")
    36	    sub.add_parser("check")
    37	    args = parser.parse_args()
    38	
    39	    if args.command == "write":
    40	        path = OUT / f"{args.name}.json"
    41	        records = json.loads(path.read_text()) if path.exists() else {}
    42	        for target in args.targets:
    43	            records[target] = fingerprint.record(args.source_root, target)
    44	        path.write_text(json.dumps(records, indent=2, sort_keys=True) + "\n")
    45	        print(f"wrote {len(args.targets)} target(s) to {path.relative_to(REPO)}")
    46	        return 0
    47	
    48	    pinned = fingerprint.load_pinned()
    49	    fingerprint.verify(sorted(pinned), source_root=args.source_root, pinned=pinned)
    50	    print(f"{len(pinned)} pinned fingerprint(s) match {args.source_root}")
    51	    return 0
    52	
    53	
    54	if __name__ == "__main__":
    55	    raise SystemExit(main())
tools/run_cpu_tests.sh
     1	#!/usr/bin/env bash
     2	# CPU tests of the plugin against the pinned SGLang checkout. Selects sources
     3	# with PYTHONPATH; never installs into or modifies the shared environment.
     4	set -euo pipefail
     5	
     6	repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
     7	pin_root=${QSA_PIN_ROOT:-$repo/../.worktrees/sglang-pin-76e06febab}
     8	python=${QSA_PYTHON:-$repo/../flash-next-env/bin/python}
     9	
    10	cd "$repo"
    11	export PYTHONPATH="$repo/src:$pin_root/python${PYTHONPATH:+:$PYTHONPATH}"
    12	# Hide CUDA the same way the fork's CPU runner does (numeric, invalid ordinal).
    13	export CUDA_VISIBLE_DEVICES=99
    14	export TRITON_INTERPRET=1
    15	# Never inherit feature switches from the caller's shell.
    16	unset SGLANG_QSA_MODEL_COMPAT SGLANG_QSA_HISPARSE_V3
    17	
    18	exec "$python" -m pytest -q -p no:cacheprovider tests "$@"


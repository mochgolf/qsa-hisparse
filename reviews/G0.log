    34	
    35	def load_plugins_by_group(
    36	    group: str,
    37	    excluded_dists: set[str] | None = None,
    38	) -> dict[str, tuple[Callable[[], Any], str | None]]:
    39	    """
    40	    Discover and load plugins registered under the given entry point group.
    41	
    42	    Args:
    43	        group: The setuptools entry_point group name.
    44	        excluded_dists: Distribution names to skip. Plugins from these
    45	            distributions are never ``ep.load()``-ed (avoids importing
    46	            their modules and pulling hardware-specific dependencies).
    47	
    48	    Returns:
    49	        Dictionary mapping plugin name to ``(callable, dist_name)``.
    50	    """
    51	    # SGLANG_PLUGINS whitelist (comma-separated plugin names)
    52	    allowed_set: set[str] | None = None
    53	    allowed_str = envs.SGLANG_PLUGINS.get()
    54	    if allowed_str:
    55	        allowed_set = {x.strip() for x in allowed_str.split(",") if x.strip()}
    56	
    57	    discovered = entry_points(group=group)
    58	    if len(discovered) == 0:
    59	        logger.debug("No plugins found for group %s.", group)
    60	        return {}
    61	
    62	    logger.info("Available plugins for group %s:", group)
    63	    for ep in discovered:
    64	        logger.info("  - %s -> %s", ep.name, ep.value)
    65	
    66	    plugins: dict[str, tuple[Callable[[], Any], str | None]] = {}
    67	    for ep in discovered:
    68	        if allowed_set is not None and ep.name not in allowed_set:
    69	            logger.info("Skipping plugin %s (not in SGLANG_PLUGINS)", ep.name)
    70	            continue
    71	        dist_name = ep.dist.name if ep.dist else None
    72	        if excluded_dists and dist_name in excluded_dists:
    73	            logger.info(
    74	                "Skipping plugin %s (dist %s excluded by SGLANG_PLATFORM)",
    75	                ep.name,
    76	                dist_name,
    77	            )
    78	            continue
    79	        try:
    80	            func = ep.load()
    81	            plugins[ep.name] = (func, dist_name)
    82	            logger.info("Loaded plugin %s from group %s", ep.name, group)
    83	        except Exception:
    84	            logger.exception("Failed to load plugin %s from group %s", ep.name, group)
    85	
    86	    return plugins

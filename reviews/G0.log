   198	                )
   199	                if row["repeated_warm"]["output_ids"] != row["cold_0"]["output_ids"]:
   200	                    mismatch(f"Repeated warm output differs: {case['name']}", row)
   201	            row["passed"] = not row.get("output_mismatches")
   202	            row["gpu_after"] = gpu_snapshot()
   203	            write_json(args.output, report)
   204	            print(

   443	def test_late_hooks_fail_final_verification(registry, fake, tmp_path, monkeypatch):
   444	    from sglang.srt.plugins.hook_registry import HookSource, HookType
   445	
   446	    fake.pin("qsa_fake.mod.Box.value", "qsa_fake.mod.configure")
   447	    patching.patch("qsa_fake.mod.Box.value", "after", feature="model_compat", row="R1")(
   448	        lambda result, self: result + 1
   449	    )
   450	    calls = []
   451	
   452	    @patching.patch("qsa_fake.mod.configure", "before", feature="framework", row="FW")
   453	    def verifier(*args, **kwargs):
   454	        calls.append(1)
   455	        patching.verify_final("scheduler", tp_rank=0)
   456	
   457	    patching.activate(COMPAT)
   458	    monkeypatch.setenv(patching.ACTIVATION_DIR_ENV, str(tmp_path / "records"))
   459	    mod = _mod()
   460	
   461	    # A later plugin replacing an unrelated class cannot remove the verifier.
   462	    registry.register("qsa_fake.mod.Child", type("Other", (mod.Box,), {}), HookType.REPLACE, source=_foreign())
   463	    registry.apply_hooks()
   464	    assert mod.configure() == "configured" and calls == [1]
   465	    record = json.loads(next((tmp_path / "records").glob("scheduler-*.json")).read_text())
   466	    assert record["patches"] == ["qsa_fake.mod.Box.value", "qsa_fake.mod.configure"]
   467	
   468	    # A later hook on the verifier's own target is skipped by the registry,
   469	    # which final verification reports.
   470	    registry.register("qsa_fake.mod.configure", lambda *a, **k: None, HookType.BEFORE, source=_foreign())
   471	    registry.apply_hooks()
   472	    with pytest.raises(PluginActivationError, match="overlapping"):
   473	        mod.configure()
   474	

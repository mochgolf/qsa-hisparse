   476	    own = HookSource(plugin_name=patching.PLUGIN_NAME, dist_name=patching.DIST_NAME)
   477	    registry.register("qsa_fake.mod.double", lambda r, x: r, HookType.AFTER, source=own)
   478	    with pytest.raises(PluginActivationError, match="registered after activation"):
   479	        mod.configure()

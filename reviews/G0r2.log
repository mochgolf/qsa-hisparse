   286	        elif is_staticmethod:
   287	            wrapped = staticmethod(wrapped)
   288	            logger.debug("Preserved @staticmethod decorator for %s", target)
   289	
   290	        setattr(obj, attr_name, wrapped)
   291	
   292	        # Propagate the patch to all other modules that imported the original
   293	        # via ``from source_module import name``.  Python's ``from X import Y``
   294	        # copies the reference at import time; patching X alone leaves
   295	        # importers with a stale binding.
   296	        if wrapped is not original:
   297	            extra = _propagate_patch(original, wrapped, obj)
   298	            if extra:
   299	                logger.debug(
   300	                    "Propagated patch for %s to %d additional module(s)",
   301	                    target,
   302	                    extra,
   303	                )
   304	
   305	        sources = sorted({_format_source(src) for _, _, src in hooks})
   306	        logger.info(
   307	            "Applied %d hook(s) to %s (from: %s)",
   308	            len(hooks),
   309	            target,
   310	            ", ".join(sources),
   311	        )
   312	
   313	    @classmethod
   314	    def reset(cls):
   315	        """Reset all hooks and patches. Primarily for testing."""
   316	        cls._hooks.clear()
   317	        cls._patched.clear()
   318	
   319	
   320	def _propagate_patch(original: object, wrapped: object, source_module: object) -> int:
   321	    """Propagate a monkey-patch to all modules holding a stale ``from X import Y`` binding.
   322	
   323	    After ``setattr(source_module, name, wrapped)`` updates the defining module,
   324	    other modules that did ``from source_module import name`` still hold a direct
   325	    reference to the old *original* object.  This walks ``sys.modules`` and
   326	    replaces every such stale binding with *wrapped*.
   327	
   328	    Returns the number of additional module attributes that were patched.
   329	    """
   330	    patched_count = 0
   331	    for mod in list(sys.modules.values()):
   332	        if mod is source_module or mod is None:
   333	            continue
   334	        if not isinstance(mod, types.ModuleType):
   335	            continue
   336	        try:
   337	            mod_vars = vars(mod)
   338	        except TypeError:
   339	            continue
   340	        for attr_name, attr_value in list(mod_vars.items()):
   341	            if attr_value is original:
   342	                try:
   343	                    setattr(mod, attr_name, wrapped)
   344	                    patched_count += 1
   345	                except (AttributeError, TypeError):
   346	                    pass
   347	    return patched_count
   348	
   349	
   350	def _wrap_fn(original_fn: Callable, hook: Callable, hook_type: HookType) -> Callable:
   351	    """Create a wrapper function based on the hook type."""
   352	    if hook_type == HookType.REPLACE:
   353	
   354	        @functools.wraps(original_fn)
   355	        def wrapper(*args, **kwargs):
   356	            return hook(*args, **kwargs)
   357	
   358	        wrapper.__wrapped__ = original_fn
   359	        return wrapper
   360	
   361	    elif hook_type == HookType.BEFORE:
   362	
   363	        @functools.wraps(original_fn)
   364	        def wrapper(*args, **kwargs):
   365	            result = hook(*args, **kwargs)
   366	            if result is not None:
   367	                args, kwargs = result
   368	            return original_fn(*args, **kwargs)
   369	
   370	        wrapper.__wrapped__ = original_fn
   371	        return wrapper
   372	
   373	    elif hook_type == HookType.AFTER:
   374	
   375	        @functools.wraps(original_fn)
   376	        def wrapper(*args, **kwargs):
   377	            result = original_fn(*args, **kwargs)
   378	            modified = hook(result, *args, **kwargs)
   379	            return modified if modified is not None else result
   380	
   381	        wrapper.__wrapped__ = original_fn
   382	        return wrapper
   383	
   384	    elif hook_type == HookType.AROUND:
   385	
   386	        @functools.wraps(original_fn)
   387	        def wrapper(*args, **kwargs):
   388	            return hook(original_fn, *args, **kwargs)
   389	
   390	        wrapper.__wrapped__ = original_fn
   391	        return wrapper
   392	
   393	    else:
   394	        raise ValueError(f"Unknown hook type: {hook_type}")
   395	
   396	
   397	def plugin_hook(
   398	    target: str,
   399	    type: HookType = HookType.AFTER,
   400	) -> Callable:
   401	    """Decorator that registers a function or class as a hook on *target*.
   402	
   403	    Usage::
   404	
   405	        # Function hook (AROUND)
   406	        @plugin_hook("sglang.srt.managers.scheduler.Scheduler.schedule",
   407	                      type=HookType.AROUND)
   408	        def my_timer(original_fn, *args, **kwargs):
   409	            start = time.perf_counter()
   410	            result = original_fn(*args, **kwargs)
   411	            print(f"Elapsed: {time.perf_counter() - start:.3f}s")
   412	            return result
   413	
   414	        # Class replacement (REPLACE)
   415	        @plugin_hook("sglang.srt.managers.scheduler.Scheduler",
   416	                      type=HookType.REPLACE)
   417	        class MyScheduler(Scheduler):
   418	            ...
   419	
   420	    The decorated function/class is returned unchanged so it can still be
   421	    used directly if needed.
   422	    """
   423	
   424	    def decorator(hook: Callable) -> Callable:
   425	        HookRegistry.register(target, hook, type)
   426	        return hook
   427	
   428	    return decorator
     1	"""
     2	SGLang Unified Plugin Framework.
     3	
     4	Supports two types of plugins via setuptools entry_points:
     5	1. Hardware Platform Plugins (sglang.srt.platforms) - register custom hardware platforms
     6	2. General Plugins (sglang.srt.plugins) - inject hooks into functions/methods, replace classes, etc.
     7	
     8	Plugins are discovered automatically when installed via pip.
     9	- Platform plugins: use ``SGLANG_PLATFORM`` to select when multiple are installed.
    10	- General plugins: use ``SGLANG_PLUGINS`` (comma-separated) to restrict which are loaded.
    11	"""
    12	
    13	import logging
    14	from collections.abc import Callable
    15	from importlib.metadata import entry_points
    16	from typing import Any
    17	
    18	from sglang.srt.environ import envs
    19	from sglang.srt.plugins.hook_registry import (
    20	    HookRegistry,
    21	    HookSource,
    22	    _current_plugin_source,
    23	)
    24	
    25	logger = logging.getLogger(__name__)
    26	
    27	# Entry point group names
    28	PLATFORM_PLUGINS_GROUP = "sglang.srt.platforms"
    29	GENERAL_PLUGINS_GROUP = "sglang.srt.plugins"
    30	
    31	# Guard against multiple loads in the same process
    32	_plugins_loaded = False
    33	
    34	
    35	def load_plugins_by_group(
    36	    group: str,
    37	    excluded_dists: set[str] | None = None,
    38	) -> dict[str, tuple[Callable[[], Any], str | None]]:
    39	    """
    40	    Discover and load plugins registered under the given entry point group.
    41	
    42	    Args:
    43	        group: The setuptools entry_point group name.
    44	        excluded_dists: Distribution names to skip. Plugins from these
    45	            distributions are never ``ep.load()``-ed (avoids importing
    46	            their modules and pulling hardware-specific dependencies).
    47	
    48	    Returns:
    49	        Dictionary mapping plugin name to ``(callable, dist_name)``.
    50	    """
    51	    # SGLANG_PLUGINS whitelist (comma-separated plugin names)
    52	    allowed_set: set[str] | None = None
    53	    allowed_str = envs.SGLANG_PLUGINS.get()
    54	    if allowed_str:
    55	        allowed_set = {x.strip() for x in allowed_str.split(",") if x.strip()}
    56	
    57	    discovered = entry_points(group=group)
    58	    if len(discovered) == 0:
    59	        logger.debug("No plugins found for group %s.", group)
    60	        return {}
    61	
    62	    logger.info("Available plugins for group %s:", group)
    63	    for ep in discovered:
    64	        logger.info("  - %s -> %s", ep.name, ep.value)
    65	
    66	    plugins: dict[str, tuple[Callable[[], Any], str | None]] = {}
    67	    for ep in discovered:
    68	        if allowed_set is not None and ep.name not in allowed_set:
    69	            logger.info("Skipping plugin %s (not in SGLANG_PLUGINS)", ep.name)
    70	            continue
    71	        dist_name = ep.dist.name if ep.dist else None
    72	        if excluded_dists and dist_name in excluded_dists:
    73	            logger.info(
    74	                "Skipping plugin %s (dist %s excluded by SGLANG_PLATFORM)",
    75	                ep.name,
    76	                dist_name,
    77	            )
    78	            continue
    79	        try:
    80	            func = ep.load()
    81	            plugins[ep.name] = (func, dist_name)
    82	            logger.info("Loaded plugin %s from group %s", ep.name, group)
    83	        except Exception:
    84	            logger.exception("Failed to load plugin %s from group %s", ep.name, group)
    85	
    86	    return plugins
    87	
    88	
    89	def _get_excluded_dists() -> set[str]:
    90	    """Compute dist names to skip when ``SGLANG_PLATFORM`` is set.
    91	
    92	    Returns dist names that provide a platform plugin but are NOT the one
    93	    selected by ``SGLANG_PLATFORM``.  This prevents unselected platform
    94	    packages from registering hooks that pull their hardware dependencies.
    95	    """
    96	    selected = envs.SGLANG_PLATFORM.get()
    97	    if not selected:
    98	        return set()
    99	    platform_eps = entry_points(group=PLATFORM_PLUGINS_GROUP)
   100	    return {ep.dist.name for ep in platform_eps if ep.dist and ep.name != selected}
   101	
   102	
   103	def load_plugins():
   104	    """
   105	    Load and execute all general plugins, then apply registered hooks.
   106	
   107	    Idempotent - safe to call multiple times. General plugins are functions
   108	    whose side effects (registering hooks, replacing classes, etc.) are the
   109	    desired behavior. Return values are ignored.
   110	
   111	    When ``SGLANG_PLATFORM`` is set, general plugins from unselected platform
   112	    packages are automatically skipped (avoids pulling their dependencies).
   113	
   114	    After all plugins execute, ``HookRegistry.apply_hooks()`` is called
   115	    automatically so callers only need this single function call.
   116	
   117	    This should be called early in every process (main, engine core, workers).
   118	    """
   119	    global _plugins_loaded
   120	    if _plugins_loaded:
   121	        return
   122	    _plugins_loaded = True
   123	
   124	    plugins = load_plugins_by_group(
   125	        GENERAL_PLUGINS_GROUP,
   126	        excluded_dists=_get_excluded_dists(),
   127	    )
   128	
   129	    for name, (func, dist_name) in plugins.items():
   130	        source = HookSource(plugin_name=name, dist_name=dist_name)
   131	        token = _current_plugin_source.set(source)
   132	        try:
   133	            func()
   134	            logger.info("Executed general plugin: %s", name)
   135	        except Exception:
   136	            logger.exception("Failed to execute general plugin: %s", name)
   137	        finally:
   138	            _current_plugin_source.reset(token)
   139	
   140	    # Apply all registered hooks (idempotent — already-patched targets are skipped).
   141	    HookRegistry.apply_hooks()
    elif disaggregation_mode == DisaggregationMode.DECODE:
        if get_parallel().pp_size > 1:
            scheduler.event_loop_pp_disagg_decode()
        elif scheduler.enable_overlap:
            scheduler.event_loop_overlap_disagg_decode()
        else:
            scheduler.event_loop_normal_disagg_decode()


def configure_scheduler_process(
    server_args: ServerArgs,
    gpu_id: int,
    tp_rank: int,
    attn_cp_rank: int,
    moe_dp_rank: int,
    moe_ep_rank: int,
    pp_rank: int,
    dp_rank: Optional[int],
    display_tp_rank: Optional[int] = None,
    display_dp_rank: Optional[int] = None,
    display_moe_ep_rank: Optional[int] = None,
) -> Optional[int]:
    """Configure scheduler worker logging and process title.

    display_* ranks are cosmetic; runtime ranks stay local.
    """
    kill_itself_when_parent_died()

    # Generate the logger prefix
    if dp_rank is None and "SGLANG_DP_RANK" in os.environ:
        # [For Router] if env var "SGLANG_DP_RANK" exist, set dp_rank to the value of the env var
        dp_rank = int(os.environ["SGLANG_DP_RANK"])

    shown_dp = display_dp_rank if display_dp_rank is not None else dp_rank
    shown_tp = display_tp_rank if display_tp_rank is not None else tp_rank
    shown_moe_ep = (
        display_moe_ep_rank if display_moe_ep_rank is not None else moe_ep_rank
    )

    prefix = ""
    if shown_dp is not None:
        prefix += f" DP{shown_dp}"
    if get_parallel().pp_size > 1:
        prefix += f" PP{pp_rank}"
    if get_parallel().attn_cp_size > 1:
        prefix += f" ATTN_CP{attn_cp_rank}"
    if get_parallel().moe_dp_size > 1:
        prefix += f" MOE_DP{moe_dp_rank}"
    if get_parallel().tp_size > 1:
        prefix += f" TP{shown_tp}"
    if get_parallel().ep_size > 1:
        prefix += f" EP{shown_moe_ep}"

    # Config the process
    setproctitle.setproctitle(f"sglang::scheduler{prefix.replace(' ', '_')}")
    faulthandler.enable()

    # Configure the logger
    configure_logger(server_args, prefix=prefix)
    suppress_other_loggers()

    # Set cpu affinity to this gpu process
    if envs.SGLANG_SET_CPU_AFFINITY.get():
        set_gpu_proc_affinity(
            get_parallel().pp_size,
            get_parallel().tp_size,
            get_parallel().nnodes,
            gpu_id,
        )
    if not envs.SGLANG_NUMA_BIND_V2.get():
        numa_node = get_numa_node_if_available(server_args, gpu_id)
        if numa_node is not None:
            numa_bind_to_node(numa_node)

    return dp_rank


def run_scheduler_process(
    server_args: ServerArgs,
    port_args: PortArgs,
    gpu_id: int,
    tp_rank: int,
    attn_cp_rank: int,
    moe_dp_rank: int,
    moe_ep_rank: int,
    pp_rank: int,
    dp_rank: Optional[int],
    pipe_writer,
    display_tp_rank: Optional[int] = None,
    display_dp_rank: Optional[int] = None,
    display_moe_ep_rank: Optional[int] = None,
):
    # Load plugins so hooks can override Scheduler and its dependencies.
    load_plugins()
    # Publish before anything in this process reads configuration.
    publish(server_args, role="scheduler")
    dp_rank = configure_scheduler_process(
        server_args,
        gpu_id,
        tp_rank,
        attn_cp_rank,
        moe_dp_rank,
        moe_ep_rank,
        pp_rank,
        dp_rank,
        display_tp_rank=display_tp_rank,
        display_dp_rank=display_dp_rank,
        display_moe_ep_rank=display_moe_ep_rank,
    )
    parent_process = psutil.Process().parent()

    # Set up tracing
    if get_observability().enable_trace:
        process_tracing_init(
            get_observability().otlp_traces_endpoint,
            "sglang",
            trace_modules=get_observability().trace_modules,
        )
        thread_label = "Scheduler"
        if get_disagg().disaggregation_mode == "prefill":
            thread_label = "Prefill Scheduler"
        elif get_disagg().disaggregation_mode == "decode":
            thread_label = "Decode Scheduler"
        trace_set_thread_info(thread_label, tp_rank, dp_rank, pp_rank)

    # Create a scheduler and run the event loop
    scheduler = None
    try:
        scheduler = Scheduler(
            server_args,
            port_args,
            gpu_id,
            tp_rank,
            moe_ep_rank,
            pp_rank,
            attn_cp_rank,
            moe_dp_rank,
            dp_rank,
        )

        # Send initialization info back to the parent process
        pipe_writer.send(scheduler.get_init_info())

        # Run the event loop (blocks until a ShutdownReq sets gracefully_exit)
        scheduler.run_event_loop()

    except Exception:
        traceback = get_exception_traceback()
        logger.error(f"Scheduler hit an exception: {traceback}")
        parent_process.send_signal(signal.SIGQUIT)
        # Opt-in: SIGKILL the pgroup so sibling ranks don't spew thousands
        # of NCCL/TCPStore tracebacks before they finally die.
        if envs.SGLANG_KILLPG_ON_SCHEDULER_EXCEPTION.get():
            try:
                os.killpg(os.getpgrp(), signal.SIGKILL)
            except Exception:
                pass
    finally:
        if scheduler is not None:
            # FPM has a background ZMQ publisher thread that needs explicit
            # teardown to flush queued metrics and close the socket cleanly.


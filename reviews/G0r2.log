   145	    @classmethod
   146	    def apply_hooks(cls):
   147	        """
   148	        Apply all registered hooks to their target functions/classes.
   149	
   150	        This performs the actual monkey-patching. Should be called once after
   151	        all plugins have been loaded and before the engine starts.
   152	
   153	        Targets with class REPLACE hooks are applied first, so that
   154	        subsequent method-level hooks (AROUND, BEFORE, AFTER) on child
   155	        attributes resolve against the *replaced* class rather than the
   156	        original.
   157	        """
   158	        sorted_items = sorted(cls._hooks.items(), key=cls._target_sort_key)
   159	        for target, hooks in sorted_items:
   160	            if target in cls._patched:
   161	                continue
   162	            try:
   163	                cls._apply_target(target, hooks)
   164	                cls._patched.add(target)
   165	            except Exception:
   166	                logger.exception("Failed to apply hooks to %s", target)
   167	
   168	    @staticmethod
   169	    def _target_sort_key(item):
   170	        """Sort key: class REPLACE targets (tier 0) before all others (tier 1).
   171	
   172	        This ensures that when a class is replaced, subsequent method-level
   173	        hooks on ``ClassName.method`` resolve against the replacement class.
   174	        """
   175	        _target, hooks = item
   176	        has_class_replace = any(
   177	            isinstance(h, type) and ht == HookType.REPLACE for ht, h, _ in hooks
   178	        )
   179	        return (0 if has_class_replace else 1, _target)

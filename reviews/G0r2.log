     2	# CPU tests of the plugin against the pinned SGLang checkout. Selects sources
     3	# with PYTHONPATH; never installs into or modifies the shared environment.
     4	# Default interpreter: the owner-approved validation env (read-only use).
     5	set -euo pipefail
     6	
     7	repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
     8	pin_root=${QSA_PIN_ROOT:-$repo/../.worktrees/sglang-pin-76e06febab}
     9	python=${QSA_PYTHON:-$repo/../service/runtime-env-sglang-20260923/bin/python}
    10	
    11	cd "$repo"
    12	export PYTHONPATH="$repo/src:$pin_root/python${PYTHONPATH:+:$PYTHONPATH}"
    13	# Hide CUDA the same way the fork's CPU runner does (numeric, invalid ordinal).
    14	export CUDA_VISIBLE_DEVICES=99
    15	export TRITON_INTERPRET=1
    16	# Never write bytecode into the pinned checkout or the shared interpreter.
    17	export PYTHONDONTWRITEBYTECODE=1
    18	# Never inherit feature switches or opt-ins for GPU/service tests
    19	# (tests/conftest.py enforces the exclusions at collection time).
    20	unset SGLANG_QSA_MODEL_COMPAT SGLANG_QSA_HISPARSE_V3 SGLANG_QSA_ACTIVATION_DIR \
    21	  QSA_GPU_TESTS QSA_SERVICE_LIFECYCLE_TESTS SGLANG_TEST_MARLIN_GPU SGLANG_PLUGINS
    22	
    23	exec "$python" -m pytest -q -p no:cacheprovider tests "$@"
[build-system]
requires = ["setuptools>=64"]
build-backend = "setuptools.build_meta"

[project]
name = "sglang-qsa-hisparse"
version = "0.1.0.dev0"
description = "QSA HiSparse CPU KV offload and host prefix reuse as an SGLang general plugin."
requires-python = ">=3.10"
license = { text = "Apache-2.0" }
# SGLang itself is not declared: the supported revision is a pinned commit
# (see sglang_qsa_hisparse.PINNED_SGLANG_COMMIT), verified at activation by
# per-target source fingerprints rather than by a package version.
dependencies = []

[project.entry-points."sglang.srt.plugins"]
qsa_hisparse = "sglang_qsa_hisparse.plugin:load"

[tool.setuptools.packages.find]
where = ["src"]

[tool.setuptools.package-data]
sglang_qsa_hisparse = ["fingerprints/*.json", "kernels/csrc/**/*"]

[tool.pytest.ini_options]
markers = [
    "integration: needs patches owned by several workstreams; run after merging",
    "gpu: needs CUDA; skipped by the CPU runner",
]
"""Feature switches. Reading them imports nothing from SGLang.

``model_compat`` carries the reference fork's shared-path behavior: quantized
MoE loading, INT8-row PLE, QSA FP8 descales, and deterministic kernels.
``hisparse`` is the request-scoped CPU KV offload runtime and host prefix
cache; it keeps the fork's ``SGLANG_QSA_HISPARSE_V3`` spelling and requires
``model_compat`` because the fork never ran it without those changes.
"""

import os
from collections.abc import Mapping
from dataclasses import dataclass
from typing import Optional

from sglang_qsa_hisparse.errors import PluginConfigError

MODEL_COMPAT_ENV = "SGLANG_QSA_MODEL_COMPAT"
HISPARSE_ENV = "SGLANG_QSA_HISPARSE_V3"
HISPARSE_MODES = ("p2-offload", "p2-resident", "offload", "resident")

MODEL_COMPAT = "model_compat"
HISPARSE = "hisparse"
FEATURES = (MODEL_COMPAT, HISPARSE)


@dataclass(frozen=True)
class Features:
    model_compat: bool = False
    hisparse_mode: Optional[str] = None

    @property
    def active(self) -> tuple[str, ...]:
        names = []
        if self.model_compat:
            names.append(MODEL_COMPAT)
        if self.hisparse_mode is not None:
            names.append(HISPARSE)
        return tuple(names)


def read_features(environ: Optional[Mapping[str, str]] = None) -> Features:
    environ = os.environ if environ is None else environ
    compat = environ.get(MODEL_COMPAT_ENV, "")
    if compat not in ("", "0", "1"):
        raise PluginConfigError(f"{MODEL_COMPAT_ENV} must be 0 or 1, got {compat!r}")
    mode = environ.get(HISPARSE_ENV) or None
    if mode is not None and mode not in HISPARSE_MODES:
        raise PluginConfigError(
            f"{HISPARSE_ENV} must be one of {HISPARSE_MODES}, got {mode!r}"
        )
    if mode is not None and compat != "1":
        raise PluginConfigError(f"{HISPARSE_ENV} requires {MODEL_COMPAT_ENV}=1")
    return Features(model_compat=compat == "1", hisparse_mode=mode)
"""Activation failures that SGLang's plugin loader cannot swallow.

``sglang.srt.plugins.load_plugins`` and ``HookRegistry.apply_hooks`` catch
``Exception`` and only log it. A requested feature that fails to activate
must stop the process instead of serving unpatched upstream behavior, so
activation errors derive from ``BaseException``.
"""


class PluginActivationError(BaseException):
    """A requested feature could not be activated exactly as pinned."""


class PluginConfigError(PluginActivationError):
    """Feature switches are malformed or form an unsupported combination."""


class FingerprintMismatch(PluginActivationError):
    """A patch target's source differs from the pinned SGLang revision."""

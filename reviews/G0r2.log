   172	    return decorator
   173	
   174	
   175	def load_manifest() -> dict[str, dict]:
   176	    path = resources.files("sglang_qsa_hisparse").joinpath("manifest.json")
   177	    return json.loads(path.read_text(encoding="utf-8"))["rows"]
   178	
   179	
   180	def _import_feature_modules(feature: str) -> None:
   181	    package = importlib.import_module(f"sglang_qsa_hisparse.patches.{feature}")
   182	    for info in sorted(pkgutil.iter_modules(package.__path__), key=lambda i: i.name):
   183	        importlib.import_module(f"{package.__name__}.{info.name}")
   184	
   185	
   186	def _import_framework_hooks() -> None:
   187	    importlib.import_module("sglang_qsa_hisparse.patches.framework")
   188	
   189	
   190	def _overlaps(a: str, b: str) -> bool:
   191	    return a == b or a.startswith(b + ".") or b.startswith(a + ".")
   192	
   193	
   194	def _check_manifest(
   195	    wanted: set[str], specs: list[PatchSpec], attaches: list[AttachSpec]
   196	) -> None:
   197	    manifest = load_manifest()
   198	    for feature in sorted(wanted - {FRAMEWORK}):
   199	        if not any(entry["feature"] == feature for entry in manifest.values()):
   200	            raise PluginActivationError(f"Feature {feature} has no manifest rows")
   201	    expected = set()
   202	    for row, entry in manifest.items():
   203	        if entry["feature"] not in wanted:
   204	            continue
   205	        expected |= {("patch", row, p["target"], p["hook_type"]) for p in entry["patches"]}
   206	        expected |= {("attach", row, f"{a['owner']}.{a['name']}", "") for a in entry["attach"]}
   207	    declared = {("patch", s.row, s.target, s.hook_type) for s in specs}
   208	    declared |= {("attach", a.row, a.target, "") for a in attaches}
   209	    missing, extra = sorted(expected - declared), sorted(declared - expected)
   210	    if missing or extra:
   211	        raise PluginActivationError(
   212	            f"Declarations differ from manifest.json; missing {missing}; "
   213	            f"undeclared in manifest {extra}"
   214	        )
   215	
   216	
   217	def collect(features: Features) -> tuple[list[PatchSpec], list[AttachSpec]]:
   218	    _import_framework_hooks()
   219	    for feature in features.active:
   220	        _import_feature_modules(feature)
   221	    wanted = set(features.active) | {FRAMEWORK}
   222	    specs = [spec for spec in _declared if spec.feature in wanted]
   223	    attaches = [spec for spec in _attached if spec.feature in wanted]
   224	
   225	    replaced: set[str] = set()
   226	    for spec in specs:
   227	        if spec.hook_type != "replace":
   228	            continue
   229	        if spec.target in replaced:
   230	            raise PluginActivationError(f"Two REPLACE patches on {spec.target}")
   231	        replaced.add(spec.target)
   232	    class_replaced = {
   233	        s.target for s in specs if s.hook_type == "replace" and isinstance(s.hook, type)
   234	    }
   235	    nested = sorted(
   236	        s.target for s in specs for owner in class_replaced if s.target.startswith(owner + ".")
   237	    )
   238	    if nested:
   239	        raise PluginActivationError(
   240	            f"Hooks on members of a replaced class (implement them in the "
   241	            f"replacement class instead): {nested}"
   242	        )
   243	    attached = [spec.target for spec in attaches]
   244	    duplicates = sorted({t for t in attached if attached.count(t) > 1})
   245	    if duplicates:
   246	        raise PluginActivationError(f"Members attached twice: {duplicates}")
   247	    hooked = sorted(set(attached) & {spec.target for spec in specs})
   248	    if hooked:
   249	        raise PluginActivationError(f"Hooks on attached members: {hooked}")
   250	    _check_manifest(wanted, specs, attaches)
   251	    return specs, attaches
   252	
   253	
   254	def _raw_attribute(target: str):
   255	    return fingerprint.raw_attribute(target)
   256	
   257	
   258	def _foreign_overlaps(registry, targets: set[str]) -> list[str]:
   259	    found = []
   260	    for key, hooks in registry._hooks.items():
   261	        foreign = [h for h in hooks if h[2] is None or h[2].plugin_name != PLUGIN_NAME]
   262	        if foreign and any(_overlaps(key, target) for target in targets):
   263	            found.append(key)
   264	    return sorted(found)
   265	
   266	
   267	def _defines(owner: object, name: str) -> bool:
   268	    if isinstance(owner, type):
   269	        return any(name in klass.__dict__ for klass in owner.__mro__)
   270	    return hasattr(owner, name)
   271	
   272	
   273	def _attach_all(attaches: list[AttachSpec]) -> None:
   274	    owners = {spec.owner: pkgutil.resolve_name(spec.owner) for spec in attaches}
   275	    present = [spec.target for spec in attaches if _defines(owners[spec.owner], spec.name)]
   276	    if present:
   277	        raise PluginActivationError(
   278	            f"Attach targets already defined upstream (pin drift): {present}"
   279	        )
   280	    for spec in attaches:
   281	        setattr(owners[spec.owner], spec.name, spec.value)
   282	    _verify_attached(attaches)
   283	
   284	
   285	def _verify_attached(attaches: list[AttachSpec]) -> None:
   286	    missing = [
   287	        spec.target for spec in attaches if _raw_attribute(spec.target) is not spec.value
   288	    ]
   289	    if missing:
   290	        raise PluginActivationError(f"Members were not attached: {missing}")
   291	
   292	
   293	def activate(features: Features) -> list[PatchSpec]:
   294	    """Apply all patches for ``features`` exactly once per process."""
   295	    global _activated
   296	    if _activated is not None:
   297	        if _activated != features:
   298	            raise PluginActivationError(
   299	                f"Already activated with {_activated}, requested {features}"
   300	            )
   301	        wanted = set(features.active) | {FRAMEWORK}
   302	        return [s for s in _declared if s.feature in wanted]
   303	
   304	    specs, attaches = collect(features)
   305	    names = {s.target for s in specs}
   306	    names |= {d for s in specs for d in s.depends}
   307	    names |= {d for s in attaches for d in s.depends}
   308	    unchecked = {n for s in specs for n in s.unchecked_bindings}
   309	    fingerprint.verify(sorted(names - unchecked))
   310	    fingerprint.verify(sorted(names & unchecked), check_bindings=False)
   311	    properties = sorted(s.target for s in specs if isinstance(_raw_attribute(s.target), property))
   312	    if properties:
   313	        raise PluginActivationError(f"Properties cannot be hook targets: {properties}")
   314	
   315	    from sglang.srt.plugins.hook_registry import HookRegistry, HookSource, HookType
   316	
   317	    targets = {spec.target for spec in specs}
   318	    overlap = _foreign_overlaps(HookRegistry, targets | {a.target for a in attaches})
   319	    if overlap:
   320	        raise PluginActivationError(f"Other plugins hook overlapping targets: {overlap}")
   321	    originals = {target: _raw_attribute(target) for target in targets}
   322	    source = HookSource(plugin_name=PLUGIN_NAME, dist_name=DIST_NAME)
   323	    for spec in specs:
   324	        HookRegistry.register(
   325	            spec.target, spec.hook, HookType(spec.hook_type), source=source
   326	        )
   327	    # Apply only this plugin's targets (class REPLACE first, as the registry
   328	    # does); other plugins' entries are left for load_plugins()'s final pass.
   329	    # The registry's own apply loop logs and skips failures; this does not.
   330	    ours = sorted(
   331	        ((t, HookRegistry._hooks[t]) for t in targets), key=HookRegistry._target_sort_key
   332	    )
   333	    for target, hooks in ours:
   334	        HookRegistry._apply_target(target, hooks)
   335	        HookRegistry._patched.add(target)
   336	    failed = sorted(t for t in targets if _raw_attribute(t) is originals[t])
   337	    if failed:
   338	        raise PluginActivationError(f"Hooks were not applied to: {failed}")
   339	    _applied.update({target: _raw_attribute(target) for target in targets})
   340	    _frozen_hooks.update({t: tuple(HookRegistry._hooks[t]) for t in targets})
   341	    # Attach last, so owners resolve to any class we replaced.
   342	    _attach_all(attaches)
   343	    _attached_live[:] = attaches
   344	    _activated = features
   345	    logger.info(
   346	        "QSA HiSparse plugin activated %s with %d patches and %d attached members",
   347	        features.active,
   348	        len(specs),
   349	        len(attaches),
   350	    )
   351	    return specs
   352	
   353	
   354	def verify_final(role: str, **details: object) -> None:
   355	    """Re-check activation after every plugin registered; record the result."""
   356	    if _activated is None:
   357	        raise PluginActivationError("verify_final called before activation")
   358	    from sglang.srt.plugins.hook_registry import HookRegistry
   359	
   360	    targets = set(_applied) | {a.target for a in _attached_live}
   361	    overlap = _foreign_overlaps(HookRegistry, targets)
   362	    if overlap:
   363	        raise PluginActivationError(
   364	            f"Other plugins registered overlapping hooks after activation: {overlap}"
   365	        )
   366	    late = sorted(
   367	        key
   368	        for key, hooks in HookRegistry._hooks.items()
   369	        if tuple(hooks) != _frozen_hooks.get(key, tuple(hooks))
   370	        or (
   371	            key not in _frozen_hooks
   372	            and any(h[2] is not None and h[2].plugin_name == PLUGIN_NAME for h in hooks)
   373	        )
   374	    )
   375	    if late:
   376	        raise PluginActivationError(f"Hooks registered after activation: {late}")
   377	    changed = sorted(t for t, live in _applied.items() if _raw_attribute(t) is not live)
   378	    if changed:
   379	        raise PluginActivationError(f"Patched targets were replaced afterwards: {changed}")
   380	    _verify_attached(_attached_live)
   381	
   382	    directory = os.environ.get(ACTIVATION_DIR_ENV)
   383	    if directory:
   384	        record = {
   385	            "pid": os.getpid(),
   386	            "role": role,
   387	            "features": list(_activated.active),
   388	            "hisparse_mode": _activated.hisparse_mode,
   389	            "patches": sorted(_applied),
   390	            "attached": sorted(a.target for a in _attached_live),
   391	            "pinned_sglang_commit": PINNED_SGLANG_COMMIT,
   392	            **details,
   393	        }
   394	        path = Path(directory) / f"{role}-{os.getpid()}.json"
   395	        path.parent.mkdir(parents=True, exist_ok=True)
   396	        path.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n")
     1	"""Source and binding fingerprints of patch targets.
     2	
     3	Activation is gated on the raw bytes of every module that contains a patch
     4	target or a declared dependency: the plugin is pinned to one SGLang commit,
     5	so any edit to such a module fails closed, including conditional
     6	redefinitions, module constants, helpers, line endings and indentation.
     7	
     8	Each record also has
     9	- ``sha256``: raw bytes of the definition, its decorators, and the
    10	  decorator/header lines of every enclosing class (upgrade diagnostics);
    11	- ``chains``: per binding mode (``cpu``/``cuda``, because some SGLang modules
    12	  choose implementations at import time from CUDA availability), the live
    13	  binding as imported from the pinned checkout, from the attribute itself
    14	  through every ``__wrapped__`` level (type and code location per level).
    15	  Activation recomputes the chain for the current mode from the installed
    16	  objects and requires an exact match, so a foreign wrapper, even one using
    17	  ``functools.wraps``, cannot pass as the pinned definition. A missing chain
    18	  for the current mode fails activation; regenerate it in that mode.
    19	
    20	Writing a record requires exactly one binding of each name along the
    21	qualified path, counting every Python binding form in that scope.
    22	
    23	Pinned records live in ``fingerprints/*.json`` (one file per patch module, so
    24	parallel work does not share a file).
    25	"""
    26	
    27	import ast
    28	import hashlib
    29	import importlib
    30	import inspect
    31	import json
    32	import pkgutil
    33	import sys
    34	from importlib import resources
    35	from pathlib import Path
    36	
    37	from sglang_qsa_hisparse.errors import FingerprintMismatch
    38	
    39	_DEFINITIONS = (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)
    40	_NEW_SCOPES = (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef, ast.Lambda)
    41	_COMPREHENSIONS = (ast.ListComp, ast.SetComp, ast.DictComp, ast.GeneratorExp)
    42	_BODY_FIELDS = ("body", "orelse", "finalbody", "handlers", "cases")
    43	
    44	
    45	def _sha256(data: bytes) -> str:
    46	    return hashlib.sha256(data).hexdigest()
    47	
    48	
    49	# Binding analysis -------------------------------------------------------------
    50	
    51	
    52	def _expression_bindings(node: ast.AST, names: list[str], in_comprehension: bool) -> None:
    53	    """Names an expression binds in the enclosing scope."""
    54	    if isinstance(node, ast.NamedExpr):
    55	        names.append(node.target.id)  # Walrus binds outside comprehensions too.
    56	        _expression_bindings(node.value, names, in_comprehension)
    57	        return
    58	    if isinstance(node, _NEW_SCOPES):
    59	        return
    60	    if isinstance(node, ast.Name) and isinstance(node.ctx, (ast.Store, ast.Del)):
    61	        if not in_comprehension:
    62	            names.append(node.id)
    63	        return
    64	    inner = in_comprehension or isinstance(node, _COMPREHENSIONS)
    65	    for child in ast.iter_child_nodes(node):
    66	        _expression_bindings(child, names, inner)
    67	
    68	
    69	def _pattern_bindings(pattern: ast.AST, names: list[str]) -> None:
    70	    for node in ast.walk(pattern):
    71	        if isinstance(node, (ast.MatchAs, ast.MatchStar)) and node.name:
    72	            names.append(node.name)
    73	        elif isinstance(node, ast.MatchMapping) and node.rest:
    74	            names.append(node.rest)
    75	
    76	
    77	def _statement_bindings(statement: ast.stmt) -> list[str]:
    78	    """Names bound in the current scope by ``statement`` itself (not its body)."""
    79	    names: list[str] = []
    80	    if isinstance(statement, _DEFINITIONS):
    81	        names.append(statement.name)
    82	        for expression in statement.decorator_list:
    83	            _expression_bindings(expression, names, False)
    84	        return names
    85	    if isinstance(statement, (ast.Import, ast.ImportFrom)):
    86	        for alias in statement.names:
    87	            if alias.name != "*":
    88	                names.append(alias.asname or alias.name.split(".")[0])
    89	        return names
    90	    if isinstance(statement, (ast.Global, ast.Nonlocal)):
    91	        return names
    92	    if isinstance(statement, ast.AnnAssign) and statement.value is None:
    93	        return names  # Annotation only: declares, does not bind.
    94	    if isinstance(statement, ast.Try) or type(statement).__name__ == "TryStar":
    95	        for handler in statement.handlers:
    96	            if handler.name:
    97	                names.append(handler.name)
    98	            if handler.type is not None:
    99	                _expression_bindings(handler.type, names, False)
   100	        return names
   101	    if isinstance(statement, ast.Match):
   102	        _expression_bindings(statement.subject, names, False)
   103	        for case in statement.cases:
   104	            _pattern_bindings(case.pattern, names)
   105	            if case.guard is not None:
   106	                _expression_bindings(case.guard, names, False)
   107	        return names
   108	    for field, value in ast.iter_fields(statement):
   109	        if field in _BODY_FIELDS:
   110	            continue
   111	        for node in value if isinstance(value, list) else [value]:
   112	            if isinstance(node, ast.AST):
   113	                _expression_bindings(node, names, False)
   114	    return names
   115	
   116	
   117	def _statements(scope: ast.AST):
   118	    """Statements executed in ``scope``, entering compound statements only."""
   119	    pending = list(getattr(scope, "body", ()))
   120	    while pending:
   121	        statement = pending.pop()
   122	        yield statement
   123	        if isinstance(statement, _NEW_SCOPES):
   124	            continue
   125	        for field in _BODY_FIELDS:
   126	            for child in getattr(statement, field, ()) or ():
   127	                if isinstance(child, (ast.ExceptHandler, ast.match_case)):
   128	                    pending.extend(child.body)
   129	                else:
   130	                    pending.append(child)
   131	
   132	
   133	def binding_count(scope: ast.AST, name: str) -> int:
   134	    return sum(_statement_bindings(s).count(name) for s in _statements(scope))
   135	
   136	
   137	def _locate(tree: ast.Module, qualname: str) -> tuple[ast.AST, list[ast.ClassDef]]:
   138	    node: ast.AST = tree
   139	    enclosing: list[ast.ClassDef] = []
   140	    for part in qualname.split("."):
   141	        count = binding_count(node, part)
   142	        direct = [
   143	            child
   144	            for child in getattr(node, "body", ())
   145	            if isinstance(child, _DEFINITIONS) and child.name == part
   146	        ]
   147	        if count != 1 or len(direct) != 1:
   148	            raise LookupError(
   149	                f"{qualname}: {part!r} must have exactly one binding, a direct "
   150	                f"definition; found {count} binding(s), {len(direct)} direct"
   151	            )
   152	        if isinstance(node, ast.ClassDef):
   153	            enclosing.append(node)
   154	        node = direct[0]
   155	    return node, enclosing
   156	
   157	
   158	def _first_line(node: ast.AST) -> int:
   159	    return min([node.lineno] + [d.lineno for d in node.decorator_list])
   160	
   161	
   162	def _header(lines: list[bytes], klass: ast.ClassDef) -> bytes:
   163	    return b"".join(lines[_first_line(klass) - 1 : klass.body[0].lineno - 1])
   164	
   165	
   166	def definition_record(path: str | Path, qualname: str) -> dict:
   167	    data = Path(path).read_bytes()
   168	    node, enclosing = _locate(ast.parse(data), qualname)
   169	    lines = data.splitlines(keepends=True)
   170	    first = _first_line(node)
   171	    segment = b"".join(_header(lines, k) for k in enclosing)
   172	    segment += b"".join(lines[first - 1 : node.end_lineno])
   173	    return {
   174	        "qualname": qualname,
   175	        "kind": "class" if isinstance(node, ast.ClassDef) else "function",
   176	        "first_line": first,
   177	        "def_line": node.lineno,
   178	        "sha256": _sha256(segment),
   179	        "module_sha256": _sha256(data),
   180	    }
   181	
   182	
   183	# Live bindings ------------------------------------------------------------------
   184	
   185	
   186	def _type_name(value: object) -> str:
   187	    kind = type(value)
   188	    return f"{kind.__module__}.{kind.__qualname__}"
   189	
   190	
   191	def _location(filename: str, root: Path) -> str:
   192	    path = Path(filename).resolve()
   193	    try:
   194	        return path.relative_to(root.resolve()).as_posix()
   195	    except ValueError:
   196	        return "<external>/" + path.name
   197	
   198	
   199	def raw_attribute(target: str) -> object:
   200	    owner_path, name = target.rsplit(".", 1)
   201	    owner = pkgutil.resolve_name(owner_path)
   202	    if isinstance(owner, type) and name in owner.__dict__:
   203	        return owner.__dict__[name]
   204	    return getattr(owner, name)
   205	
   206	
   207	def live_chain(value: object, root: Path) -> list[dict]:
   208	    """Describe ``value`` and every ``__wrapped__`` level beneath it."""
   209	    chain: list[dict] = []
   210	    seen: set[int] = set()
   211	    current = value
   212	    while current is not None and id(current) not in seen:
   213	        seen.add(id(current))
   214	        entry: dict = {"type": _type_name(current)}
   215	        if isinstance(current, type):
   216	            entry["class"] = current.__qualname__
   217	            try:
   218	                entry["file"] = _location(inspect.getsourcefile(current), root)
   219	            except TypeError:
   220	                entry["file"] = None
   221	        code = getattr(current, "__code__", None)
   222	        if code is not None:
   223	            entry["code"] = [_location(code.co_filename, root), code.co_firstlineno]
   224	        chain.append(entry)
   225	        if isinstance(current, (staticmethod, classmethod)):
   226	            current = current.__func__
   227	        elif isinstance(current, property):
   228	            current = current.fget
   229	        else:
   230	            current = getattr(current, "__wrapped__", None)
   231	    return chain
   232	
   233	
   234	def binding_mode() -> str:
   235	    try:
   236	        import torch
   237	    except ImportError:
   238	        return "cpu"
   239	    return "cuda" if torch.cuda.is_available() else "cpu"
   240	
   241	
   242	# Records ------------------------------------------------------------------------
   243	
   244	
   245	def resolve_file(source_root: str | Path, target: str) -> tuple[str, str]:
   246	    """Map ``pkg.module.Qual.name`` to (relative module file, qualname) by path."""
   247	    root = Path(source_root)
   248	    parts = target.split(".")
   249	    for cut in range(len(parts) - 1, 0, -1):
   250	        stem = Path(*parts[:cut])
   251	        for candidate in (stem.with_suffix(".py"), stem / "__init__.py"):
   252	            if (root / candidate).is_file():
   253	                return candidate.as_posix(), ".".join(parts[cut:])
   254	    raise LookupError(f"No module file under {root} for {target}")
   255	
   256	
   257	def record(source_root: str | Path, target: str, previous: dict | None = None) -> dict:
   258	    """Pinned record of ``target`` in the current binding mode.
   259	
   260	    Imports ``target`` from ``source_root``. Chains recorded earlier for other
   261	    modes are kept when the module bytes are unchanged.
   262	    """
   263	    root = Path(source_root).resolve()
   264	    file, qualname = resolve_file(root, target)
   265	    module_name = target[: -len(qualname) - 1]
   266	    imported = sys.modules.get(module_name) or importlib.import_module(module_name)
   267	    if Path(imported.__file__).resolve() != root / file:
   268	        raise LookupError(
   269	            f"{module_name} imports from {imported.__file__}, not {root / file}; "
   270	            "put the pinned checkout first on sys.path"
   271	        )
   272	    data = {"file": file, **definition_record(root / file, qualname)}
   273	    chains = {}
   274	    if previous and previous.get("module_sha256") == data["module_sha256"]:
   275	        chains.update(previous.get("chains", {}))
   276	    chains[binding_mode()] = live_chain(raw_attribute(target), root)
   277	    data["chains"] = dict(sorted(chains.items()))
   278	    return data
   279	
   280	
   281	def installed_source_root() -> Path:
   282	    import sglang  # Already imported whenever SGLang loads this plugin.
   283	
   284	    return Path(sglang.__file__).resolve().parent.parent
   285	
   286	
   287	def load_pinned() -> dict[str, dict]:
   288	    pinned: dict[str, dict] = {}
   289	    directory = resources.files("sglang_qsa_hisparse").joinpath("fingerprints")
   290	    for entry in sorted(directory.iterdir(), key=lambda e: e.name):
   291	        if not entry.name.endswith(".json"):
   292	            continue
   293	        for target, data in json.loads(entry.read_text(encoding="utf-8")).items():
   294	            if target in pinned and pinned[target] != data:
   295	                raise FingerprintMismatch(f"{target}: conflicting pinned records")
   296	            pinned[target] = data
   297	    return pinned
   298	
   299	
   300	def verify(
   301	    names: list[str],
   302	    *,

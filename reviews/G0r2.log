   112	        if isinstance(hook, type) and hook_type != HookType.REPLACE:
   113	            raise TypeError(
   114	                f"Class {hook.__name__} can only be used with HookType.REPLACE, "
   115	                f"got HookType.{hook_type.name}. "
   116	                f"Use a function for BEFORE/AFTER/AROUND hooks."
   117	            )
   118	        resolved_source = source or _current_plugin_source.get()
   119	        # Warn on duplicate REPLACE for the same target
   120	        if hook_type == HookType.REPLACE:
   121	            existing_replace = [
   122	                (h, src) for ht, h, src in cls._hooks[target] if ht == HookType.REPLACE
   123	            ]
   124	            if existing_replace:
   125	                prev, prev_src = existing_replace[-1]
   126	                prev_name = getattr(prev, "__qualname__", None) or repr(prev)
   127	                new_name = getattr(hook, "__qualname__", None) or repr(hook)
   128	                logger.warning(
   129	                    "Multiple REPLACE hooks on '%s': previous (%s [%s]) will be "
   130	                    "overridden by (%s [%s]). The last registered REPLACE takes effect.",
   131	                    target,
   132	                    prev_name,
   133	                    _format_source(prev_src),
   134	                    new_name,
   135	                    _format_source(resolved_source),
   136	                )
   137	        cls._hooks[target].append((hook_type, hook, resolved_source))
   138	        logger.debug(
   139	            "Registered %s hook on %s [%s]",
   140	            hook_type.value,
   141	            target,
   142	            _format_source(resolved_source),
   143	        )

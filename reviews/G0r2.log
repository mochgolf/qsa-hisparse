     1	#!/usr/bin/env python3
     2	"""Generate the activation manifest from docs/patch-inventory.md.
     3	
     4	The manifest lists, per inventory row, the patches and attachments a feature
     5	must declare. Activation requires the declared set for each requested
     6	feature to equal the manifest exactly, so a missing patch module, a missing
     7	row, or an extra undeclared hook fails closed. Rows that need several hook
     8	types or name new members are completed by OVERRIDES below.
     9	
    10	    tools/manifest.py          # write src/sglang_qsa_hisparse/manifest.json
    11	    tools/manifest.py --check  # fail if the file is stale
    12	"""
    13	
    14	import argparse
    15	import json
    16	import re
    17	import sys
    18	from pathlib import Path
    19	
    20	REPO = Path(__file__).resolve().parents[1]
    21	INVENTORY = REPO / "docs" / "patch-inventory.md"
    22	OUT = REPO / "src" / "sglang_qsa_hisparse" / "manifest.json"
    23	HOOK_TYPES = ("before", "after", "around", "replace")
    24	BACKEND = "sglang.srt.layers.attention.qwen_sparse_attn_backend.QwenSparseAttnBackend"
    25	
    26	OVERRIDES = {
    27	    "K03": {
    28	        "patches": [
    29	            {"target": "sglang.srt.mem_cache.qsa_kv_pool.QSATokenToKVPool.__init__", "hook_type": "around"},
    30	            {"target": "sglang.srt.mem_cache.memory_pool.HybridLinearKVPool.__init__", "hook_type": "before"},
    31	        ]
    32	    },
    33	    "Q04": {"attach": [{"owner": BACKEND, "name": "_kv_descales"}, {"owner": BACKEND, "name": "_store_kv"}]},
    34	    "Q09": {
    35	        "attach": [
    36	            {"owner": BACKEND, "name": "_qsa_local_head_shape"},
    37	            {"owner": BACKEND, "name": "_ensure_fa2_graph_wrapper"},
    38	            {"owner": BACKEND, "name": "_can_run_fa2_graph"},
    39	        ]
    40	    },
    41	}
    42	
    43	FRAMEWORK_ROWS = {
    44	    "FW1": {
    45	        "feature": "framework",
    46	        "patches": [
    47	            {
    48	                "target": "sglang.srt.managers.scheduler.configure_scheduler_process",
    49	                "hook_type": "before",
    50	            }
    51	        ],
    52	        "attach": [],
    53	    }
    54	}
    55	
    56	
    57	def build() -> dict:
    58	    rows: dict = {}
    59	    for line in INVENTORY.read_text().splitlines():
    60	        match = re.match(r"^\| ([A-Z]+\d+[a-z]?) \|", line)
    61	        if not match:
    62	            continue
    63	        cells = [c.strip() for c in line.strip().strip("|").split("|")]
    64	        if len(cells) < 9 or cells[0] in rows or cells[0] in FRAMEWORK_ROWS:
    65	            continue  # Appendix tables repeat IDs with fewer columns.
    66	        row, feature_cell, target_cell, hook_cell = cells[0], cells[3], cells[4], cells[5]
    67	        feature = feature_cell.split(":")[0].split(" ")[0].strip("*")
    68	        if feature not in ("model_compat", "hisparse"):
    69	            continue
    70	        entry = {"feature": feature, "patches": [], "attach": []}
    71	        if row in OVERRIDES:
    72	            entry.update(OVERRIDES[row])
    73	        else:
    74	            kind = hook_cell.split(":")[0].split(" ")[0].strip(".,(")
    75	            targets = re.findall(r"`(sglang\.[A-Za-z0-9_.]+)`", target_cell)
    76	            if kind in HOOK_TYPES:
    77	                if len(targets) != 1:
    78	                    raise SystemExit(f"{row}: expected one target, found {targets}")
    79	                entry["patches"] = [{"target": targets[0], "hook_type": kind}]
    80	            elif kind not in ("moved/owned", "moved", "none"):
    81	                raise SystemExit(f"{row}: unknown hook kind {kind!r}")
    82	        if entry["patches"] or entry["attach"]:
    83	            rows[row] = entry
    84	    rows.update(FRAMEWORK_ROWS)
    85	    return {"source": "docs/patch-inventory.md", "rows": dict(sorted(rows.items()))}
    86	
    87	
    88	def main() -> int:
    89	    parser = argparse.ArgumentParser()
    90	    parser.add_argument("--check", action="store_true")
    91	    args = parser.parse_args()
    92	    text = json.dumps(build(), indent=2) + "\n"
    93	    if args.check:
    94	        if not OUT.exists() or OUT.read_text() != text:
    95	            print("manifest.json is stale; run tools/manifest.py", file=sys.stderr)
    96	            return 1
    97	        return 0
    98	    OUT.write_text(text)
    99	    rows = json.loads(text)["rows"]
   100	    print(f"wrote {len(rows)} rows to {OUT.relative_to(REPO)}")
   101	    return 0
   102	
   103	
   104	if __name__ == "__main__":
   105	    raise SystemExit(main())

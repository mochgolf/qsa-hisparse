   552	
   553	def _run_loader(tmp_path, environ, prelude="", epilogue=""):
   554	    dist = tmp_path / "sglang_qsa_hisparse-0.1.0.dev0.dist-info"
   555	    dist.mkdir(exist_ok=True)
   556	    (dist / "METADATA").write_text(
   557	        "Metadata-Version: 2.1\nName: sglang-qsa-hisparse\nVersion: 0.1.0.dev0\n"
   558	    )
   559	    (dist / "entry_points.txt").write_text(
   560	        "[sglang.srt.plugins]\nqsa_hisparse = sglang_qsa_hisparse.plugin:load\n"
   561	    )
   562	    code = prelude + textwrap.dedent(
   563	        """
   564	        import sys
   565	        from sglang.srt.plugins import load_plugins
   566	        from sglang.srt.plugins.hook_registry import HookRegistry
   567	        load_plugins()
   568	        print("hooks", sorted(HookRegistry._hooks))
   569	        print("patched", sorted(HookRegistry._patched))
   570	        print("patching", "sglang_qsa_hisparse.patching" in sys.modules)
   571	        """
   572	    ) + epilogue
   573	    env = {
   574	        key: value
   575	        for key, value in os.environ.items()
   576	        if not key.startswith("SGLANG_QSA_") and key != "SGLANG_PLUGINS"
   577	    }
   578	    env.update(environ)
   579	    env["PYTHONPATH"] = f"{tmp_path}{os.pathsep}{env.get('PYTHONPATH', '')}"
   580	    return subprocess.run(
   581	        [sys.executable, "-c", code], env=env, capture_output=True, text=True
   582	    )

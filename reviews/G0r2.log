   186	            raise ValueError(
   187	                f"Invalid target path (need at least module.attr): {target}"
   188	            )
   189	
   190	        obj_path, attr_name = parts
   191	        obj = pkgutil.resolve_name(obj_path)
   192	
   193	        # Check if the original is a classmethod or staticmethod by
   194	        # inspecting __dict__ before getattr() triggers the descriptor
   195	        # protocol (which would lose the wrapper type for classmethod).
   196	        original = getattr(obj, attr_name)
   197	        is_classmethod = False
   198	        is_staticmethod = False
   199	        if isinstance(obj, type):
   200	            raw_attr = obj.__dict__.get(attr_name)
   201	            if isinstance(raw_attr, classmethod):
   202	                is_classmethod = True
   203	                original = raw_attr.__func__
   204	            elif isinstance(raw_attr, staticmethod):
   205	                is_staticmethod = True
   206	                original = raw_attr.__func__
   207	
   208	        # Cross-target conflict detection: if the parent object is a class
   209	        # that was already class-REPLACE'd, and the replacement class defines
   210	        # its own version of this method, a method REPLACE here will silently
   211	        # override the replacement class's implementation.
   212	        if isinstance(obj, type) and obj_path in cls._patched:
   213	            has_method_replace = any(ht == HookType.REPLACE for ht, _, _ in hooks)
   214	            if has_method_replace and attr_name in obj.__dict__:
   215	                replace_sources = [
   216	                    _format_source(src)
   217	                    for ht, _, src in hooks
   218	                    if ht == HookType.REPLACE
   219	                ]
   220	                logger.warning(
   221	                    "Method REPLACE on '%s' will override the class REPLACE's "
   222	                    "own implementation of '%s'. If this is unintended, remove "
   223	                    "the method REPLACE and modify the replacement class "
   224	                    "directly, or use AROUND to wrap it. (from: %s)",
   225	                    target,
   226	                    attr_name,
   227	                    ", ".join(replace_sources),
   228	                )
   229	
   230	        # Guard: if the target is a class, only REPLACE is safe. Wrapping a
   231	        # class in a function would break isinstance/issubclass/inheritance.
   232	        if isinstance(original, type):
   233	            bad = [ht for ht, _, _ in hooks if ht != HookType.REPLACE]
   234	            if bad:
   235	                raise TypeError(
   236	                    f"Target '{target}' is a class. Only HookType.REPLACE is "
   237	                    f"allowed for class targets (got {bad[0].value}). "
   238	                    f"To hook a method, use '{target}.<method_name>' instead."
   239	                )
   240	
   241	        # Warn about risky hook combinations
   242	        hook_types = [ht for ht, _, _ in hooks]
   243	        around_count = hook_types.count(HookType.AROUND)
   244	        has_replace = HookType.REPLACE in hook_types
   245	        has_others = any(ht != HookType.REPLACE for ht in hook_types)
   246	
   247	        if around_count > 1:
   248	            around_sources = [
   249	                _format_source(src) for ht, _, src in hooks if ht == HookType.AROUND
   250	            ]
   251	            logger.warning(
   252	                "Multiple AROUND hooks on '%s' (%d hooks, from: %s). If any AROUND hook "
   253	                "skips calling original_fn, inner hooks will be bypassed.",
   254	                target,
   255	                around_count,
   256	                ", ".join(around_sources),
   257	            )
   258	        if has_replace and has_others:
   259	            logger.info(
   260	                "Target '%s' has both REPLACE and %s hooks. "
   261	                "REPLACE will be applied first, then wrapped by other hooks.",
   262	                target,
   263	                ", ".join(
   264	                    sorted({ht.value for ht in hook_types if ht != HookType.REPLACE})
   265	                ),
   266	            )
   267	
   268	        # Build the wrapper chain.
   269	        # Sort: REPLACE hooks first (stable sort preserves registration order
   270	        # within the same type). This ensures AROUND/BEFORE/AFTER always wrap
   271	        # the replaced function, regardless of registration order.
   272	        sorted_hooks = sorted(hooks, key=lambda h: 0 if h[0] == HookType.REPLACE else 1)
   273	        wrapped = original
   274	        for hook_type, hook, _src in sorted_hooks:
   275	            if isinstance(hook, type) and hook_type == HookType.REPLACE:

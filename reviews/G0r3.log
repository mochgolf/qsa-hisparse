    18	def pytest_collection_modifyitems(config, items):
    19	    allow_gpu = os.environ.get("QSA_GPU_TESTS") == "1"
    20	    allow_service = os.environ.get("QSA_SERVICE_LIFECYCLE_TESTS") == "1"
    21	    skip_gpu = pytest.mark.skip(reason="GPU test; set QSA_GPU_TESTS=1")
    22	    kept, deselected = [], []
    23	    for item in items:
    24	        lifecycle = "ServiceLifecycleTests" in item.nodeid or item.get_closest_marker(
    25	            "service_lifecycle"
    26	        )
    27	        if lifecycle and not allow_service:
    28	            deselected.append(item)
    29	            continue
    30	        if item.get_closest_marker("gpu") and not allow_gpu:
    31	            item.add_marker(skip_gpu)
    32	        kept.append(item)
    33	    if deselected:
    34	        config.hook.pytest_deselected(items=deselected)
    35	        items[:] = kept

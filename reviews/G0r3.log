     1	"""Source and binding fingerprints of patch targets.
     2	
     3	Activation is gated on the raw bytes of every module that contains a patch
     4	target or a declared dependency: the plugin is pinned to one SGLang commit,
     5	so any edit to such a module fails closed, including conditional
     6	redefinitions, module constants, helpers, line endings and indentation.
     7	
     8	Each record also has
     9	- ``sha256``: raw bytes of the definition, its decorators, and the
    10	  decorator/header lines of every enclosing class (upgrade diagnostics);
    11	- ``chains``: per binding mode (``cpu``/``cuda``, because some SGLang modules
    12	  choose implementations at import time from CUDA availability), the live
    13	  binding as imported from the pinned checkout, from the attribute itself
    14	  through every ``__wrapped__`` level (type and code location per level).
    15	  Activation recomputes the chain for the current mode from the installed
    16	  objects and requires an exact match, so a foreign wrapper, even one using
    17	  ``functools.wraps``, cannot pass as the pinned definition. A missing chain
    18	  for the current mode fails activation; regenerate it in that mode.
    19	
    20	Writing a record requires exactly one binding of each name along the
    21	qualified path, counting every Python binding form in that scope.
    22	
    23	Pinned records live in ``fingerprints/*.json`` (one file per patch module, so
    24	parallel work does not share a file).
    25	"""
    26	
    27	import ast
    28	import functools
    29	import hashlib
    30	import importlib
    31	import inspect
    32	import json
    33	import pkgutil
    34	import sys
    35	from importlib import resources
    36	from pathlib import Path

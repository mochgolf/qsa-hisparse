    51	
    52	
    53	def _expression_bindings(node: ast.AST, names: list[str], in_comprehension: bool) -> None:
    54	    """Names an expression binds in the enclosing scope."""
    55	    if isinstance(node, ast.NamedExpr):
    56	        names.append(node.target.id)  # Walrus binds outside comprehensions too.

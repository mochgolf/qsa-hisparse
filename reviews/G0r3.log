   675	def test_wheel_contains_activation_data(tmp_path):
   676	    import glob
   677	    import zipfile
   678	    from pathlib import Path
   679	
   680	    repo = Path(__file__).resolve().parents[1]
   681	    builder = os.environ.get("QSA_WHEEL_PYTHON", "/usr/bin/python3")
   682	    result = subprocess.run(
   683	        [builder, "-m", "pip", "wheel", "--no-deps", "--no-build-isolation",
   684	         "--no-index", "-q", "-w", str(tmp_path), str(repo)],
   685	        capture_output=True, text=True,
   686	        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
   687	        cwd=tmp_path,
   688	    )
   689	    assert result.returncode == 0, result.stderr[-2000:]
   690	    names = zipfile.ZipFile(glob.glob(str(tmp_path / "*.whl"))[0]).namelist()
   691	    package = repo / "src" / "sglang_qsa_hisparse"
   692	    expected = ["sglang_qsa_hisparse/manifest.json"] + [
   693	        f"sglang_qsa_hisparse/fingerprints/{p.name}" for p in (package / "fingerprints").glob("*.json")
   694	    ]
   695	    assert set(expected) <= set(names)
   696	    entry_points = [n for n in names if n.endswith("dist-info/entry_points.txt")]
   697	    assert len(entry_points) == 1

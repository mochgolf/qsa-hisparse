    91	            every += [a for a in (arguments.vararg, arguments.kwarg) if a]
    92	            header += [a.annotation for a in every if a.annotation is not None]
    93	            if statement.returns is not None:
    94	                header.append(statement.returns)
    95	        for expression in header:

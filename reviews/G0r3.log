   319	    if properties:
   320	        raise PluginActivationError(f"Properties cannot be hook targets: {properties}")
   321	
   322	    from sglang.srt.plugins.hook_registry import HookRegistry, HookSource, HookType
   323	
   324	    targets = {spec.target for spec in specs}
   325	    depends = names - targets
   326	    protected = targets | {a.target for a in attaches} | depends
   327	    overlap = _foreign_overlaps(HookRegistry, protected)
   328	    if overlap:
   329	        raise PluginActivationError(f"Other plugins hook overlapping targets: {overlap}")
   330	    originals = {target: _raw_attribute(target) for target in targets}
   331	    source = HookSource(plugin_name=PLUGIN_NAME, dist_name=DIST_NAME)
   332	    for spec in specs:
   333	        HookRegistry.register(
   334	            spec.target, spec.hook, HookType(spec.hook_type), source=source
   335	        )
   336	    # Apply only this plugin's targets (class REPLACE first, as the registry
   337	    # does); other plugins' entries are left for load_plugins()'s final pass.
   338	    # The registry's own apply loop logs and skips failures; this does not.
   339	    ours = sorted(
   340	        ((t, HookRegistry._hooks[t]) for t in targets), key=HookRegistry._target_sort_key
   341	    )
   342	    for target, hooks in ours:
   343	        HookRegistry._apply_target(target, hooks)
   344	        HookRegistry._patched.add(target)
   345	    failed = sorted(t for t in targets if _raw_attribute(t) is originals[t])
   346	    if failed:
   347	        raise PluginActivationError(f"Hooks were not applied to: {failed}")
   348	    _applied.update({target: _raw_attribute(target) for target in targets})
   349	    _frozen_hooks.update({t: tuple(HookRegistry._hooks[t]) for t in targets})
   350	    _frozen_depends.update({d: _raw_attribute(d) for d in depends})
   351	    # Attach last, so owners resolve to any class we replaced.
   352	    _attach_all(attaches)
   353	    _attached_live[:] = attaches
   354	    _activated = features
   355	    logger.info(
   356	        "QSA HiSparse plugin activated %s with %d patches and %d attached members",
   357	        features.active,
   358	        len(specs),
   359	        len(attaches),
   360	    )
   361	    return specs

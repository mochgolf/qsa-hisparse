    56	# Real implementation
    57	def register_custom_op(
    58	    fn: Optional[Callable] = None,
    59	    *,
    60	    op_name: Optional[str] = None,
    61	    mutates_args: Optional[List[str]] = None,
    62	    eager: bool = True,
    63	    **extra_kwargs,
    64	) -> Any:
    65	    """
    66	    A decorator to register a custom operator.
    67	
    68	    Example usage:
    69	    ```python
    70	    # inplace operator, out_shape is None by default
    71	    @register_custom_op(mutates_args=["x"])
    72	    def add_1_(x: torch.Tensor) -> None:
    73	        x.add_(1)
    74	
    75	    # operator with output, out_shape indicates the position of output
    76	    @register_custom_op(mutates_args=["x"], out_shape=0)
    77	    def add(x: torch.Tensor, y: torch.Tensor) -> torch.Tensor:
    78	        return x.add_(y)
    79	    ```
    80	
    81	    :param fn: The function to be registered as a custom operator.
    82	               If None, return a decorator.
    83	    :type fn: Callable
    84	    :param op_name: The name of the operator. If None, use the function name
    85	    :type op_name: Optional[str]
    86	    :param mutates_args: A list of argument names that are mutated in-place.
    87	    :type mutates_args: List[str]
    88	    :param out_shape: The position (int for positional, str for keyword) of the output-shape tensor.
    89	                      It is used to generate a fake implementation for torch.compile compatibility.
    90	                      If the operator is inplace and has no output, set to None.
    91	    :type out_shape: Optional[List[Union[int, str]]]
    92	    :param fake_impl: A fake implementation for the operator.
    93	                      Only one of `out_shape` or `fake_impl` should be provided.
    94	    :type fake_impl: Optional[Callable]
    95	    :param eager: Whether to register the operator eagerly.
    96	                  If False, the registration will be deferred until the first call.
    97	                  If you met any issue with torch.compile, try to set eager=True.
    98	                  Currently, to avoid misuse, we set eager=True by default.
    99	    :type eager: bool
   100	    :return: The registered JIT custom operator, or a decorator.
   101	             NOTE: the real register will occur at the first call of the function.
   102	    :rtype: Callable
   103	    """
   104	    extra_kwarg_keys = set(extra_kwargs.keys())
   105	    expected_kwarg_keys = set({"out_shape", "fake_impl"})
   106	    assert expected_kwarg_keys >= extra_kwarg_keys, (
   107	        f"Unexpected extra kwargs: {extra_kwarg_keys - expected_kwarg_keys}"
   108	    )
   109	
   110	    has_out_shape = "out_shape" in extra_kwargs
   111	    has_fake_impl = "fake_impl" in extra_kwargs
   112	    assert not (has_out_shape and has_fake_impl), (
   113	        "Only one of `out_shape` or `fake_impl` should be provided."
   114	    )
   115	    # Assume inplace if neither out_shape nor fake_impl is provided
   116	    if not (has_out_shape or has_fake_impl):
   117	        extra_kwargs["out_shape"] = None
   118	
   119	    def decorator(op_func: Callable) -> Callable:
   120	        wrapper = CustomOpWrapper(
   121	            op_name=op_name or op_func.__name__,
   122	            op_func=op_func,
   123	            mutates_args=mutates_args or [],
   124	            **extra_kwargs,
   125	        )
   126	        return wrapper.real_impl if eager else wrapper
   127	
   128	    if fn is not None:
   129	        return decorator(fn)
   130	    return decorator
   131	
   132	
   133	class CustomOpWrapper:
   134	    def __init__(
   135	        self,
   136	        op_name: str,
   137	        op_func: Callable,
   138	        mutates_args: List[str],
   139	        **extra_kwargs,
   140	    ):
   141	        self.op_name = op_name
   142	        self.op_func = op_func
   143	        self.mutates_args = mutates_args
   144	        self.extra_kwargs = extra_kwargs
   145	        self._impl: Optional[Callable] = None
   146	
   147	    def __call__(self, *args, **kwargs):
   148	        return self.real_impl(*args, **kwargs)
   149	
   150	    @property
   151	    def real_impl(self) -> Callable:
   152	        if self._impl is None:
   153	            if not hasattr(torch.ops.sglang, self.op_name):
   154	                from sglang.srt.utils.common import direct_register_custom_op
   155	
   156	                # NOTE(dark): if torch compile fail here, mark the decorator as eager
   157	                # lazy registration does not work with torch compile
   158	                direct_register_custom_op(
   159	                    op_name=self.op_name,
   160	                    op_func=self.op_func,
   161	                    mutates_args=self.mutates_args,
   162	                    fake_impl=self.fake_impl,
   163	                )
   164	            self._impl = debug_torch_op(self.op_func, self.op_name)
   165	            assert self._impl is not None
   166	        return self._impl
   167	
   168	    @property
   169	    def fake_impl(self) -> Callable:
   170	        if "fake_impl" in self.extra_kwargs:
   171	            return self.extra_kwargs["fake_impl"]
   172	        assert "out_shape" in self.extra_kwargs
   173	        signature = inspect.signature(self.op_func)
   174	        out_shape = self.extra_kwargs["out_shape"]
   175	        # check out_shape in signature
   176	
   177	        def fake_impl(*args, **kwargs):
   178	            if out_shape is None:
   179	                return None
   180	            bound = signature.bind(*args, **kwargs)
   181	            bound.apply_defaults()
   182	            try:
   183	                return torch.empty_like(
   184	                    bound.args[out_shape]
   185	                    if isinstance(out_shape, int)
   186	                    else bound.arguments[out_shape]
   187	                )
   188	            except (IndexError, KeyError):
   189	                raise RuntimeError(
   190	                    f"Cannot find output argument at position `{out_shape}` for "
   191	                    f"custom operator `{self.op_name}` with signature `{signature}`."
   192	                )
   193	
   194	        return fake_impl
   195	

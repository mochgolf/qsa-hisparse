     1	"""SGLang general-plugin entry point (``sglang.srt.plugins`` group)."""
     2	
     3	from sglang_qsa_hisparse.errors import PluginActivationError
     4	from sglang_qsa_hisparse.features import read_features
     5	
     6	
     7	def load() -> None:
     8	    """Activate requested features; with no switch set, change nothing.
     9	
    10	    SGLang's loader logs and ignores ``Exception`` from plugins, so every
    11	    failure on the enabled path (imports, fingerprints, registration) is
    12	    converted to ``PluginActivationError``, which it does not catch.
    13	    """
    14	    features = read_features()
    15	    if not features.active:
    16	        return
    17	    try:
    18	        from sglang_qsa_hisparse.patching import activate
    19	
    20	        activate(features)
    21	    except PluginActivationError:
    22	        raise
    23	    except Exception as error:
    24	        raise PluginActivationError(
    25	            f"QSA HiSparse activation of {features.active} failed: {error!r}"
    26	        ) from error
     1	"""Target-model scope for generic ``model_compat`` hooks (PLAN.md rule 9).

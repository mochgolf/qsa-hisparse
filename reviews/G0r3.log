   700	# Real SGLang loader in a fresh process --------------------------------------
   701	
   702	
   703	def _run_loader(tmp_path, environ, prelude="", epilogue=""):
   704	    dist = tmp_path / "sglang_qsa_hisparse-0.1.0.dev0.dist-info"
   705	    dist.mkdir(exist_ok=True)
   706	    (dist / "METADATA").write_text(
   707	        "Metadata-Version: 2.1\nName: sglang-qsa-hisparse\nVersion: 0.1.0.dev0\n"
   708	    )
   709	    (dist / "entry_points.txt").write_text(
   710	        "[sglang.srt.plugins]\nqsa_hisparse = sglang_qsa_hisparse.plugin:load\n"
   711	    )
   712	    code = prelude + textwrap.dedent(
   713	        """
   714	        import sys
   715	        from sglang.srt.plugins import load_plugins

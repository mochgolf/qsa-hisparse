   197	def register_custom_op_from_extern(
   198	    fn: Callable,
   199	    *,
   200	    op_name: Optional[str] = None,
   201	    mutates_args: Optional[List[str]] = None,
   202	    out_shape: Optional[Union[int, str]] = None,
   203	    out_dtype: Optional[torch.dtype] = None,
   204	    fake_impl: Optional[Callable] = None,
   205	    computed_args: Optional[dict] = None,
   206	) -> Callable:
   207	    """Wrap an external library function as a custom op for torch.compile compatibility.
   208	
   209	    Use this to wrap functions from external libraries (e.g. flashinfer kernels) that
   210	    perform operations incompatible with torch.compile/dynamo tracing, such as JIT
   211	    compilation, file I/O, or dynamic module loading.
   212	
   213	    The wrapped function becomes an opaque node in the compiled graph. Dynamo will
   214	    not trace inside it, avoiding tracing failures. A fake implementation is used
   215	    for shape/dtype propagation during compilation.
   216	
   217	    The external function must have type annotations compatible with
   218	    ``torch.library.infer_schema`` (``torch.Tensor``, ``int``, ``float``, ``bool``,
   219	    ``Optional[torch.Tensor]``, etc.).
   220	
   221	    This function is idempotent: calling it multiple times with the same ``op_name``
   222	    (or ``fn.__name__``) safely skips re-registration.
   223	
   224	    Example usage::
   225	
   226	        from flashinfer.fused_moe import trtllm_fp8_block_scale_moe
   227	
   228	        trtllm_fp8_block_scale_moe = register_custom_op_from_extern(
   229	            trtllm_fp8_block_scale_moe,
   230	            out_shape="hidden_states",
   231	            out_dtype=torch.bfloat16,
   232	            computed_args={
   233	                "tune_max_num_tokens": lambda hidden_states, **kw: next_power_of_2(
   234	                    hidden_states.shape[0]
   235	                ),
   236	            },
   237	        )
   238	
   239	    :param fn: The external function to wrap.
   240	    :param op_name: The name of the custom operator.
   241	                    Defaults to ``fn.__name__``.
   242	    :param mutates_args: A list of argument names that are mutated in-place.
   243	                         Defaults to ``[]``.
   244	    :param out_shape: The position (int) or name (str) of the argument whose shape
   245	                      matches the output tensor. Used to auto-generate a fake
   246	                      implementation. Set to ``None`` for inplace-only operators.
   247	    :param out_dtype: Override the output dtype in the fake implementation.
   248	                      If ``None``, ``torch.empty_like`` is used (same dtype as the
   249	                      reference tensor). Useful when the output dtype differs from
   250	                      the input (e.g. fp8 input -> bf16 output).
   251	    :param fake_impl: A custom fake implementation for shape/dtype propagation.
   252	                      Only one of ``out_shape`` or ``fake_impl`` should be provided.
   253	    :param computed_args: A dict mapping argument names to callables. These arguments
   254	                          are excluded from the custom op schema and computed inside
   255	                          the op body at runtime. Each callable receives the other
   256	                          arguments as keyword args and returns the computed value.
   257	                          Use this for arguments that vary dynamically (e.g.
   258	                          ``tune_max_num_tokens``) to avoid torch.compile recompilation.
   259	    :return: The registered custom op callable (``torch.ops.sglang.<op_name>``).
   260	    """
   261	    name = op_name or fn.__name__
   262	    computed_args = computed_args or {}
   263	
   264	    assert not (out_shape is not None and fake_impl is not None), (
   265	        "Only one of `out_shape` or `fake_impl` should be provided."
   266	    )
   267	
   268	    # If computed_args specified, create a wrapper with a reduced signature
   269	    # that computes the excluded args inside the op body.
   270	    if computed_args:
   271	        original_fn = fn
   272	        original_sig = inspect.signature(fn)
   273	

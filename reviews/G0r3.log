   155	    enclosing: list[ast.ClassDef] = []
   156	    for part in qualname.split("."):
   157	        count = binding_count(node, part)
   158	        direct = [
   159	            child
   160	            for child in getattr(node, "body", ())
   161	            if isinstance(child, _DEFINITIONS) and child.name == part
   162	        ]
   163	        if count != 1 or len(direct) != 1:
   164	            raise LookupError(
   165	                f"{qualname}: {part!r} must have exactly one binding, a direct "
   166	                f"definition; found {count} binding(s), {len(direct)} direct"
   167	            )
   168	        if isinstance(node, ast.ClassDef):
   169	            enclosing.append(node)
   170	        node = direct[0]
   171	    return node, enclosing
   172	
   173	
   174	def _first_line(node: ast.AST) -> int:
   175	    return min([node.lineno] + [d.lineno for d in node.decorator_list])
   176	
   177	
   178	def _header(lines: list[bytes], klass: ast.ClassDef) -> bytes:
   179	    return b"".join(lines[_first_line(klass) - 1 : klass.body[0].lineno - 1])
   180	
   181	
   182	def definition_record(path: str | Path, qualname: str) -> dict:
   183	    data = Path(path).read_bytes()
   184	    node, enclosing = _locate(ast.parse(data), qualname)
   185	    lines = data.splitlines(keepends=True)
   186	    first = _first_line(node)
   187	    segment = b"".join(_header(lines, k) for k in enclosing)
   188	    segment += b"".join(lines[first - 1 : node.end_lineno])
   189	    return {
   190	        "qualname": qualname,
   191	        "kind": "class" if isinstance(node, ast.ClassDef) else "function",
   192	        "first_line": first,
   193	        "def_line": node.lineno,
   194	        "sha256": _sha256(segment),
   195	        "module_sha256": _sha256(data),
   196	    }
   197	
   198	
   199	# Live bindings ------------------------------------------------------------------
   200	#
   201	# A binding chain describes the attribute and every level beneath it
   202	# (descriptor ``__func__``, ``property.fget``, ``__wrapped__``). Each level must
   203	# be a kind whose behavior is identified by the description; anything else is
   204	# rejected when the record is written (patches may opt out per name with
   205	# ``unchecked_bindings``, keeping module bytes pinned). Functions whose code is
   206	# outside the pinned tree (library decorators) also describe their closure and
   207	# defaults, which is where decorator factories keep their configuration.
   208	
   209	_SCALARS = (type(None), bool, int, float, complex, str, bytes)
   210	_MAX_ITEMS = 64
   211	
   212	
   213	class Undescribable(LookupError):
   214	    """A binding level whose behavior the chain cannot identify."""
   215	
   216	
   217	def _type_name(value: object) -> str:
   218	    kind = value if isinstance(value, type) else type(value)
   219	    return f"{kind.__module__}.{kind.__qualname__}"
   220	
   221	
   222	def _location(filename: str, root: Path) -> tuple[str, bool]:
   223	    path = Path(filename).resolve()
   224	    try:
   225	        return path.relative_to(root.resolve()).as_posix(), True
   226	    except ValueError:
   227	        return "<external>/" + path.name, False
   228	
   229	
   230	def _code(function, root: Path) -> dict:
   231	    code = function.__code__
   232	    location, internal = _location(code.co_filename, root)
   233	    entry = {
   234	        "code": [location, code.co_firstlineno],
   235	        "function": f"{function.__module__}.{function.__qualname__}",
   236	    }
   237	    if internal:
   238	        entry["file_sha256"] = _sha256(Path(code.co_filename).read_bytes())
   239	    return entry, internal
   240	
   241	
   242	def describe_value(value: object, root: Path, depth: int = 0) -> object:
   243	    """Identity of a closure cell, default or partial argument."""
   244	    if depth > 4:
   245	        raise Undescribable("nested too deeply")
   246	    if isinstance(value, _SCALARS):
   247	        return repr(value)
   248	    try:
   249	        import torch
   250	
   251	        if isinstance(value, (torch.dtype, torch.device)):
   252	            return repr(value)
   253	    except ImportError:
   254	        pass
   255	    if isinstance(value, type):
   256	        return {"type": _type_name(value)}
   257	    if inspect.ismodule(value):
   258	        return {"module": value.__name__}
   259	    if inspect.isfunction(value):
   260	        return _code(value, root)[0]
   261	    if inspect.ismethod(value):
   262	        return {
   263	            "method": f"{_type_name(value.__self__)}.{value.__func__.__qualname__}",
   264	            "self": describe_value(getattr(value.__self__, "__dict__", {}), root, depth + 1),
   265	        }
   266	    if inspect.isbuiltin(value):
   267	        return {"builtin": f"{getattr(value, '__module__', None)}.{value.__qualname__}"}
   268	    if isinstance(value, (tuple, list, frozenset, set)) and len(value) <= _MAX_ITEMS:
   269	        items = [describe_value(v, root, depth + 1) for v in value]
   270	        return {_type_name(value): sorted(map(repr, items)) if isinstance(value, (set, frozenset)) else items}
   271	    if isinstance(value, dict) and len(value) <= _MAX_ITEMS and all(isinstance(k, str) for k in value):
   272	        return {"dict": {k: describe_value(v, root, depth + 1) for k, v in sorted(value.items())}}
   273	    if isinstance(value, functools.partial):
   274	        return {
   275	            "partial": describe_value(value.func, root, depth + 1),
   276	            "args": describe_value(value.args, root, depth + 1),
   277	            "keywords": describe_value(value.keywords, root, depth + 1),
   278	        }
   279	    raise Undescribable(f"cannot identify value of type {_type_name(value)}")
   280	
   281	
   282	def _level(current: object, root: Path) -> tuple[dict, object]:
   283	    """Describe one level and return the next level beneath it (or None)."""
   284	    entry: dict = {"type": _type_name(current)}
   285	    if isinstance(current, (staticmethod, classmethod)):
   286	        return entry, current.__func__
   287	    if isinstance(current, property):
   288	        return entry, current.fget
   289	    if isinstance(current, type):
   290	        location = None
   291	        try:
   292	            location, internal = _location(inspect.getsourcefile(current), root)
   293	            if internal:
   294	                entry["file_sha256"] = _sha256((root / location).read_bytes())
   295	        except TypeError:
   296	            pass
   297	        entry.update(type_name=_type_name(current), file=location)
   298	        return entry, None
   299	    if inspect.isfunction(current):
   300	        code, internal = _code(current, root)
   301	        entry.update(code)
   302	        if not internal:
   303	            entry["closure"] = [
   304	                [name, describe_value(cell.cell_contents, root)]
   305	                for name, cell in zip(current.__code__.co_freevars, current.__closure__ or ())
   306	            ]
   307	            entry["defaults"] = describe_value(current.__defaults__, root)
   308	            entry["kwdefaults"] = describe_value(current.__kwdefaults__ or {}, root)
   309	        return entry, getattr(current, "__wrapped__", None)
   310	    if isinstance(current, functools.partial):
   311	        entry["partial"] = describe_value(current, root)
   312	        return entry, None
   313	    if type(current).__name__ == "_lru_cache_wrapper":
   314	        entry["cache_parameters"] = current.cache_parameters()
   315	        return entry, current.__wrapped__
   316	    if type(current).__qualname__ in ("OpOverloadPacket", "OpOverload"):
   317	        name = getattr(current, "_qualified_op_name", None) or getattr(current, "name", None)
   318	        if callable(name):
   319	            name = name()
   320	        if not name:
   321	            raise Undescribable("operator without a qualified name")
   322	        entry["op"] = str(name)
   323	        return entry, None
   324	    raise Undescribable(f"cannot identify binding level of type {_type_name(current)}")
   325	
   326	
   327	def raw_attribute(target: str) -> object:
   328	    owner_path, name = target.rsplit(".", 1)
   329	    owner = pkgutil.resolve_name(owner_path)
   330	    if isinstance(owner, type) and name in owner.__dict__:
   331	        return owner.__dict__[name]
   332	    return getattr(owner, name)
   333	
   334	
   335	def live_chain(value: object, root: Path) -> list[dict]:
   336	    """Describe ``value`` and every level beneath it; raise if unidentifiable."""
   337	    chain: list[dict] = []
   338	    seen: set[int] = set()
   339	    current = value
   340	    while current is not None:
   341	        if id(current) in seen:
   342	            raise Undescribable("cyclic wrapper chain")
   343	        seen.add(id(current))
   344	        entry, current = _level(current, root)
   345	        chain.append(entry)
   346	    return chain
   347	
   348	
   349	def binding_mode() -> str:
   350	    try:
   351	        import torch
   352	    except ImportError:
   353	        return "cpu"
   354	    return "cuda" if torch.cuda.is_available() else "cpu"
   355	
   356	
   357	# Records ------------------------------------------------------------------------
   358	
   359	
   360	def resolve_file(source_root: str | Path, target: str) -> tuple[str, str]:
   361	    """Map ``pkg.module.Qual.name`` to (relative module file, qualname) by path."""
   362	    root = Path(source_root)
   363	    parts = target.split(".")
   364	    for cut in range(len(parts) - 1, 0, -1):
   365	        stem = Path(*parts[:cut])
   366	        for candidate in (stem.with_suffix(".py"), stem / "__init__.py"):
   367	            if (root / candidate).is_file():
   368	                return candidate.as_posix(), ".".join(parts[cut:])
   369	    raise LookupError(f"No module file under {root} for {target}")
   370	
   371	
   372	def record(source_root: str | Path, target: str, previous: dict | None = None) -> dict:
   373	    """Pinned record of ``target`` in the current binding mode.
   374	
   375	    Imports ``target`` from ``source_root``. Chains recorded earlier for other
   376	    modes are kept when the module bytes are unchanged.
   377	    """
   378	    root = Path(source_root).resolve()
   379	    file, qualname = resolve_file(root, target)
   380	    module_name = target[: -len(qualname) - 1]
   381	    imported = sys.modules.get(module_name) or importlib.import_module(module_name)
   382	    if Path(imported.__file__).resolve() != root / file:
   383	        raise LookupError(
   384	            f"{module_name} imports from {imported.__file__}, not {root / file}; "
   385	            "put the pinned checkout first on sys.path"
   386	        )
   387	    data = {"file": file, **definition_record(root / file, qualname)}
   388	    chains = {}
   389	    if previous and previous.get("module_sha256") == data["module_sha256"]:
   390	        chains.update(previous.get("chains", {}))
   391	    chains[binding_mode()] = live_chain(raw_attribute(target), root)
   392	    data["chains"] = dict(sorted(chains.items()))
   393	    return data
   394	
   395	
   396	def installed_source_root() -> Path:
   397	    import sglang  # Already imported whenever SGLang loads this plugin.
   398	
   399	    return Path(sglang.__file__).resolve().parent.parent
   400	
   401	
   402	def load_pinned() -> dict[str, dict]:
   403	    pinned: dict[str, dict] = {}
   404	    directory = resources.files("sglang_qsa_hisparse").joinpath("fingerprints")
   405	    for entry in sorted(directory.iterdir(), key=lambda e: e.name):
   406	        if not entry.name.endswith(".json"):
   407	            continue
   408	        for target, data in json.loads(entry.read_text(encoding="utf-8")).items():
   409	            if target in pinned and pinned[target] != data:
   410	                raise FingerprintMismatch(f"{target}: conflicting pinned records")
   411	            pinned[target] = data
   412	    return pinned
   413	
   414	
   415	def verify(
   416	    names: list[str],
   417	    *,
   418	    source_root: str | Path | None = None,
   419	    pinned: dict[str, dict] | None = None,
   420	    check_bindings: bool = True,
   421	) -> dict[str, dict]:
   422	    """Check module bytes and live bindings of ``names`` against the pin.
   423	
   424	    Raises FingerprintMismatch on a missing record, different module bytes,
   425	    or a live binding chain that differs from the pinned one.
   426	    """
   427	    root = installed_source_root() if source_root is None else Path(source_root)
   428	    pinned = load_pinned() if pinned is None else pinned
   429	    problems = []
   430	    records = {}
   431	    for name in names:
   432	        expected = pinned.get(name)
   433	        if expected is None:
   434	            problems.append(f"{name}: no pinned fingerprint")
   435	            continue
   436	        try:
   437	            actual = definition_record(root / expected["file"], expected["qualname"])
   438	        except (LookupError, OSError, SyntaxError) as error:
   439	            problems.append(f"{name}: {error}")
   440	            continue
   441	        if actual["module_sha256"] != expected["module_sha256"]:
   442	            changed = "definition" if actual["sha256"] != expected["sha256"] else "module"
   443	            problems.append(f"{name}: {changed} differs from the pinned revision")
   444	            continue
   445	        if check_bindings:
   446	            mode = binding_mode()
   447	            pinned_chain = expected.get("chains", {}).get(mode)
   448	            if pinned_chain is None:
   449	                problems.append(f"{name}: no pinned binding chain for mode {mode}")
   450	                continue
   451	            try:
   452	                owner_path, member = name.rsplit(".", 1)
   453	                owner = pkgutil.resolve_name(owner_path)
   454	                chain = live_chain(raw_attribute(name), root)
   455	            except (AttributeError, ImportError, ValueError, LookupError) as error:
   456	                problems.append(f"{name}: cannot resolve live binding: {error!r}")
   457	                continue
   458	            if isinstance(owner, type) and member not in owner.__dict__:
   459	                problems.append(
   460	                    f"{name}: inherited, not defined on {owner.__qualname__}; "
   461	                    "live binding is not the pinned definition"
   462	                )
   463	                continue
   464	            if chain != pinned_chain:
   465	                problems.append(f"{name}: live binding is not the pinned definition")
   466	                continue
   467	        records[name] = expected
   468	    if problems:
   469	        raise FingerprintMismatch("; ".join(problems))
   470	    return records


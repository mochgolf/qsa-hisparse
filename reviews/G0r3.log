   364	def verify_final(role: str, **details: object) -> None:
   365	    """Re-check activation after every plugin registered; record the result."""
   366	    if _activated is None:
   367	        raise PluginActivationError("verify_final called before activation")
   368	    from sglang.srt.plugins.hook_registry import HookRegistry
   369	
   370	    targets = set(_applied) | {a.target for a in _attached_live} | set(_frozen_depends)
   371	    overlap = _foreign_overlaps(HookRegistry, targets)
   372	    if overlap:
   373	        raise PluginActivationError(
   374	            f"Other plugins registered overlapping hooks after activation: {overlap}"
   375	        )
   376	    late = sorted(
   377	        key
   378	        for key, hooks in HookRegistry._hooks.items()
   379	        if tuple(hooks) != _frozen_hooks.get(key, tuple(hooks))
   380	        or (
   381	            key not in _frozen_hooks
   382	            and any(h[2] is not None and h[2].plugin_name == PLUGIN_NAME for h in hooks)
   383	        )
   384	    )
   385	    if late:
   386	        raise PluginActivationError(f"Hooks registered after activation: {late}")
   387	    frozen = {**_frozen_depends, **_applied}
   388	    changed = sorted(t for t, live in frozen.items() if _raw_attribute(t) is not live)
   389	    if changed:
   390	        raise PluginActivationError(
   391	            f"Patched targets or dependencies were replaced afterwards: {changed}"
   392	        )
   393	    _verify_attached(_attached_live)
   394	
   395	    directory = os.environ.get(ACTIVATION_DIR_ENV)
   396	    if directory:
   397	        record = {
   398	            "pid": os.getpid(),
   399	            "role": role,
   400	            "features": list(_activated.active),
   401	            "hisparse_mode": _activated.hisparse_mode,
   402	            "patches": sorted(_applied),
   403	            "attached": sorted(a.target for a in _attached_live),
   404	            "pinned_sglang_commit": PINNED_SGLANG_COMMIT,
   405	            **details,
   406	        }
   407	        path = Path(directory) / f"{role}-{os.getpid()}.json"
   408	        path.parent.mkdir(parents=True, exist_ok=True)
   409	        path.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n")


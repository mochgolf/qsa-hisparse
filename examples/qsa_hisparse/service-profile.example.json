{
  "version": 1,
  "name": "qwen-local",
  "state_dir": "/absolute/path/to/private/service/state",
  "cwd": "/absolute/path/to/qsa-hisparse",
  "command": [
    "/absolute/path/to/venv/bin/python",
    "-m", "sglang.launch_server",
    "--model-path", "/absolute/path/to/local/checkpoint",
    "--served-model-name", "local-qwen",
    "--model-impl", "sglang", "--host", "127.0.0.1", "--port", "8081",
    "--tp-size", "2", "--pp-size", "1", "--dtype", "bfloat16",
    "--kv-cache-dtype", "fp8_e4m3", "--linear-attn-backend", "triton",
    "--mamba-ssm-dtype", "float32", "--mamba-radix-cache-strategy", "extra_buffer",
    "--mamba-track-interval", "64", "--max-mamba-cache-size", "40",
    "--context-length", "262144", "--max-total-tokens", "2097152",
    "--max-running-requests", "8", "--chunked-prefill-size", "2048",
    "--page-size", "64", "--random-seed", "147342228",
    "--disable-radix-cache", "--disable-overlap-schedule", "--skip-server-warmup",
    "--cuda-graph-backend-decode", "full", "--cuda-graph-backend-prefill", "disabled",
    "--disable-cuda-graph-padding", "--cuda-graph-max-bs-decode", "8",
    "--cuda-graph-bs-decode", "1", "2", "3", "4", "5", "6", "7", "8",
    "--prefill-decode-interval", "1"
  ],
  "environment": {
    "PATH": "/absolute/path/to/venv/bin:/usr/local/bin:/usr/bin:/bin",
    "PYTHONPATH": "/absolute/path/to/qsa-hisparse/python",
    "SGLANG_QWEN38_GDN_QKVZ_WNA16": "0",
    "SGLANG_QSA_HISPARSE_V3": "p2-offload",
    "SGLANG_QSA_HISPARSE_V3_OBSERVE": "light",
    "SGLANG_QSA_HISPARSE_PREFIX_CACHE_MB": "0"
  },
  "listen": {"host": "127.0.0.1", "port": 8081},
  "readiness": {
    "path": "/health",
    "model": "local-qwen",
    "timeout_seconds": 600,
    "poll_seconds": 1,
    "request_timeout_seconds": 2
  },
  "stop_timeout_seconds": 45
}

+        )
+        self.assertTrue(
+            backend._can_run_fa2_graph(
+                q.expand(8, -1, -1), k, layer, forward_batch, metadata, 2051
+            )
         )
         self.assertFalse(
-            backend._can_run_fa2_b1(
+            backend._can_run_fa2_graph(
                 q.expand(2, -1, -1), k, layer, forward_batch, metadata, 2051
             )
         )

     x, w_down, w_up = _make_inputs(_FUSED_MIX_MAX_ROWS + 1, torch.bfloat16)
     assert not fused_hc_mix_supported(x, w_down, w_up)
diff --git a/test/registered/unit/models/test_qwen4_exp_hc_stability.py b/test/registered/unit/models/test_qwen4_exp_hc_stability.py
